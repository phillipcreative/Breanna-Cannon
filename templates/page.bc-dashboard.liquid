/* ---------- Upcoming (birthdays + events) ---------- */
function upcomingItems(days){
  const today=new Date();today.setHours(0,0,0,0);
  const horizon=new Date(today);horizon.setDate(horizon.getDate()+days);
  const out=[];
  for(let i=0;i<=days;i++){const dt=new Date(today);dt.setDate(today.getDate()+i);state.events.forEach(e=>{if(occursOn(e,dt))out.push({date:new Date(dt),icon:e.type==='milestone'?'🎉':'📌',label:e.title,type:e.type});});}
  Object.entries(BIRTHDAYS).forEach(([name,md])=>{
    if(!md)return;const[mm,dd]=md.split("-").map(Number);if(!mm||!dd)return;
    let d=new Date(today.getFullYear(),mm-1,dd);if(d<today)d=new Date(today.getFullYear()+1,mm-1,dd);
    if(d>=today&&d<=horizon)out.push({date:d,icon:'🎂',label:`${name}'s birthday`,type:'birthday'});
  });
  out.sort((a,b)=>a.date-b.date);
  return out.map(o=>{
    const diff=Math.round((o.date-today)/86400000);
    o.when=diff===0?"Today":diff===1?"Tomorrow":`in ${diff} days`;
    return o;
  });
}

/* ---------- Recurrence + Google Calendar links ---------- */
const WD=["SU","MO","TU","WE","TH","FR","SA"];
const WDNAME=["Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"];
const ordinal=n=>(["","1st","2nd","3rd","4th","5th"][n])||(n+"th");
function occursOn(e,dt){
  const s=new Date(e.date+"T00:00:00");
  const sMid=new Date(s.getFullYear(),s.getMonth(),s.getDate());
  const d=new Date(dt.getFullYear(),dt.getMonth(),dt.getDate());
  if(d<sMid)return false;
  const r=e.recur||"";
  if(!r)return d.getTime()===sMid.getTime();
  if(r==="WEEKLY")return d.getDay()===s.getDay();
  if(r==="MONTHLY_DATE")return d.getDate()===s.getDate();
  if(r==="MONTHLY_NTH")return d.getDay()===s.getDay()&&Math.ceil(d.getDate()/7)===Math.ceil(s.getDate()/7);
  if(r==="YEARLY")return d.getMonth()===s.getMonth()&&d.getDate()===s.getDate();
  return false;
}
function occurrencesInMonth(e,y,m){const dim=new Date(y,m+1,0).getDate();const out=[];for(let d=1;d<=dim;d++){if(occursOn(e,new Date(y,m,d)))out.push(d);}return out;}
function recurLabel(e){
  const s=new Date(e.date+"T00:00:00");
  switch(e.recur){
    case"WEEKLY":return"Repeats weekly on "+WDNAME[s.getDay()];
    case"MONTHLY_DATE":return"Repeats monthly on the "+ordinal(s.getDate())+" of the month";
    case"MONTHLY_NTH":return"Repeats monthly on the "+ordinal(Math.ceil(s.getDate()/7))+" "+WDNAME[s.getDay()];
    case"YEARLY":return"Repeats yearly";
    default:return"";
  }
}
function gcalRecur(e){
  const s=new Date(e.date+"T00:00:00");
  switch(e.recur){
    case"WEEKLY":return"RRULE:FREQ=WEEKLY;BYDAY="+WD[s.getDay()];
    case"MONTHLY_DATE":return"RRULE:FREQ=MONTHLY;BYMONTHDAY="+s.getDate();
    case"MONTHLY_NTH":return"RRULE:FREQ=MONTHLY;BYDAY="+Math.ceil(s.getDate()/7)+WD[s.getDay()];
    case"YEARLY":return"RRULE:FREQ=YEARLY";
    default:return"";
  }
}
function gcalUrl(e){
  const iso=e.date;if(!iso)return"#";
  const s=iso.replace(/-/g,"");
  const nx=new Date(iso+"T00:00:00");nx.setDate(nx.getDate()+1);
  const en=nx.getFullYear()+String(nx.getMonth()+1).padStart(2,"0")+String(nx.getDate()).padStart(2,"0");
  const p=new URLSearchParams({action:"TEMPLATE",text:e.title||"Event",dates:s+"/"+en});
  if(e.detail)p.set("details",e.detail);
  const rr=gcalRecur(e);if(rr)p.set("recur",rr);
  return"https://calendar.google.com/calendar/render?"+p.toString();
}

/* ---------- Calendar ---------- */
function renderCalendar(){
  const y=calRef.getFullYear(),m=calRef.getMonth();
  const first=new Date(y,m,1),start=first.getDay(),dim=new Date(y,m+1,0).getDate();
  const prevDim=new Date(y,m,0).getDate();
  const todayStr=todayISO();
  const evByDay={};
  state.events.forEach(e=>{occurrencesInMonth(e,y,m).forEach(day=>{(evByDay[day]=evByDay[day]||[]).push({type:e.type,title:e.title,id:e.id,detail:e.detail,recur:e.recur});});});
  Object.entries(BIRTHDAYS).forEach(([name,md])=>{if(!md)return;const[mm,dd]=md.split("-").map(Number);if(mm-1===m&&dd){(evByDay[dd]=evByDay[dd]||[]).push({type:'birthday',title:`🎂 ${name}`});}});
  const dows=["Sun","Mon","Tue","Wed","Thu","Fri","Sat"];
  let cells="";
  for(let i=0;i<start;i++)cells+=`<div class="calcell dim"><span class="dnum">${prevDim-start+1+i}</span></div>`;
  for(let d=1;d<=dim;d++){
    const iso=`${y}-${String(m+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    const evs=evByDay[d]||[];
    cells+=`<div class="calcell ${iso===todayStr?'today':''}"><span class="dnum">${d}</span>${evs.map(e=>`<span class="calev ${e.type}" title="${esc(e.detail||e.title)}${e.recur?' (repeats)':''}">${e.recur?'↻ ':''}${esc(e.title)}</span>`).join("")}</div>`;
  }
  const total=start+dim;for(let i=total;i<Math.ceil(total/7)*7;i++)cells+=`<div class="calcell dim"><span class="dnum">${i-total+1}</span></div>`;
  panel().innerHTML=`
    <div class="card composer"><div class="eyebrow">— Add a calendar event —</div>
      <div class="row">
        <div class="col" style="min-width:200px"><label class="fld">Event</label><input type="text" id="evT" placeholder="e.g. Fall line photoshoot"></div>
        <div class="col"><label class="fld">Date</label><input type="date" id="evD"></div>
        <div class="col" style="min-width:140px"><label class="fld">Type</label><select class="in" id="evType"><option value="event">Company event</option><option value="milestone">Milestone</option></select></div>
        <div class="col" style="min-width:200px"><label class="fld">Repeat</label><select class="in" id="evRecur"><option value="">One-time</option><option value="WEEKLY">Weekly (same weekday)</option><option value="MONTHLY_DATE">Monthly (same date)</option><option value="MONTHLY_NTH">Monthly (Nth weekday — e.g. 1st Monday)</option><option value="YEARLY">Yearly</option></select></div>
        <div style="flex:0 0 auto"><button class="btn" id="evAdd" ${me?'':'disabled'}>${me?'+ Add':'Pick name'}</button></div>
      </div>
      <div class="mt"><input type="text" id="evDetail" placeholder="Details (optional)…"></div>
    </div>
    <div class="calbar">
      <span class="mlabel">${calRef.toLocaleDateString(undefined,{month:'long',year:'numeric'})}</span>
      <div class="calnav"><button id="calPrev">‹ Prev</button><button id="calToday">Today</button><button id="calNext">Next ›</button></div>
    </div>
    <div class="calgrid">${dows.map(d=>`<div class="caldow">${d}</div>`).join("")}${cells}</div>
    <p class="hint" style="margin-top:12px">Purple = company event · Pink = birthday · Gold = milestone · ↻ = repeats. Birthdays appear automatically once dates are added.</p>
    ${(()=>{const list=state.events.map(e=>({e,days:occurrencesInMonth(e,y,m)})).filter(x=>x.days.length).sort((a,b)=>a.days[0]-b.days[0]);return list.length?`<div class="card" style="margin-top:18px"><div class="sectionhead"><h2 class="h-script">Events this month</h2></div>${list.map(({e,days})=>{const dlabel=days.length>1?`${days.length} times this month`:new Date(y,m,days[0]).toLocaleDateString(undefined,{weekday:'short',month:'short',day:'numeric'});const rl=recurLabel(e);return `<div class="evrow"><span class="evdot ${e.type}"></span><div class="evinfo"><span class="evttl">${esc(e.title)}</span><span class="evsub">${dlabel}${e.detail?' · '+esc(e.detail):''}${rl?` · ${esc(rl)}`:''}</span></div><a class="gcalbtn" href="${gcalUrl(e)}" target="_blank" rel="noopener">＋ Google Calendar</a></div>`;}).join("")}</div>`:"";})()}`;
  document.getElementById("calPrev").onclick=()=>{calRef=new Date(y,m-1,1);render();};
  document.getElementById("calNext").onclick=()=>{calRef=new Date(y,m+1,1);render();};
  document.getElementById("calToday").onclick=()=>{calRef=new Date();render();};
  const add=document.getElementById("evAdd");
  if(me)add.onclick=async()=>{const t=document.getElementById("evT").value.trim(),d=document.getElementById("evD").value;if(!t||!d)return;state.events.push({id:uid(),title:t,date:d,type:document.getElementById("evType").value,detail:document.getElementById("evDetail").value.trim(),recur:document.getElementById("evRecur").value});await saveEvents();render();};
}

/* ---------- Manage Team (admin only) ---------- */
function renderManage(){
  if(!isAdmin()){panel().innerHTML=`<div class="card empty"><div class="big">Admins only</div>Managing the team is limited to the founders. Pick your name top-right if that's you.</div>`;return;}
  const OFFICES=["BCHQ","Dallas WTC","Remote","Flex"];
  const editing=(typeof mgEditing==="string");
  const cur=editing?emp(mgEditing):{};
  const formOpen=(mgEditing!==undefined);
  const nameOpts=EMPLOYEES.filter(e=>e.name!==mgEditing).map(e=>e.name);
  const form=formOpen?`
    <div class="card mgform">
      <div class="sectionhead"><h2 class="h-script">${editing?"Edit "+esc(mgEditing):"Add a person"}</h2></div>
      <div class="mgrid">
        <div class="col"><label class="fld">Name</label><input class="in" id="mgName" value="${esc(cur.name||"")}" placeholder="First Last"></div>
        <div class="col"><label class="fld">Title</label><input class="in" id="mgTitle" value="${esc(cur.title||"")}" placeholder="e.g. Marketing Manager"></div>
        <div class="col"><label class="fld">Office</label><select class="in" id="mgOffice">${OFFICES.map(o=>`<option ${cur.office===o?'selected':''}>${o}</option>`).join("")}</select></div>
        <div class="col"><label class="fld">Reports to</label><select class="in" id="mgReports"><option value="">— None (top of org) —</option>${nameOpts.map(n=>`<option ${cur.reportsTo===n?'selected':''}>${esc(n)}</option>`).join("")}</select></div>
        <div class="col"><label class="fld">Role type</label><select class="in" id="mgType"><option value="" ${!cur.type?'selected':''}>Team member</option><option value="intern" ${cur.type==='intern'?'selected':''}>Intern</option><option value="contract" ${cur.type==='contract'?'selected':''}>Contractor</option></select></div>
        <div class="col"><label class="fld">Birthday (MM-DD)</label><input class="in" id="mgBday" value="${esc(cur.birthday||"")}" placeholder="e.g. 03-21"></div>
      </div>
      <label class="fld" style="margin-top:14px">Departments</label>
      <div class="mgchecks">${DEPARTMENTS.map(d=>`<label class="mgchk"><input type="checkbox" class="mgDept" value="${esc(d)}" ${(cur.depts||[]).includes(d)?'checked':''}><span class="dot" style="background:${dColor(d)}"></span>${esc(d)}</label>`).join("")}</div>
      <label class="mgchk" style="margin-top:12px"><input type="checkbox" id="mgAccess" ${cur.access!==false?'checked':''}> Has dashboard access <span class="hint" style="margin-left:6px">(uncheck for contractors who shouldn't appear in pickers)</span></label>
      <div style="margin-top:16px;display:flex;gap:10px"><button class="btn" id="mgSave">${editing?"Save changes":"Add person"}</button><button class="btn ghost" id="mgCancel">Cancel</button></div>
    </div>`:"";
  const tag=e=>e.type==='contract'?'<span class="mtag contract">Contract</span>':e.type==='intern'?'<span class="mtag intern">Intern</span>':'';
  const rows=EMPLOYEES.map(e=>`<div class="mgrow"><div class="avatar">${initials(e.name)}</div>
    <div class="pinfo"><span class="pname">${esc(e.name)} ${tag(e)}</span><span class="ptitle">${esc(e.title||"")}${e.office?' · '+esc(e.office):''}</span></div>
    <div class="mgacts"><button class="nbtn" data-edit="${esc(e.name)}">Edit</button><button class="nbtn dismiss" data-remove="${esc(e.name)}">Remove</button></div></div>`).join("");
  panel().innerHTML=`<div class="sectionhead"><h2 class="h-script">Manage Team</h2>${mgEditing===undefined?`<button class="btn" id="mgAdd">+ Add person</button>`:''}</div>
    <p class="hint" style="margin-bottom:16px">Changes here save to the company database and update for everyone instantly — the team directory, profiles, org chart, assignment pickers, and birthdays all read from this list.</p>
    ${form}
    <div class="card">${rows}</div>`;
  const addBtn=document.getElementById("mgAdd");if(addBtn)addBtn.onclick=()=>{mgEditing=null;render();};
  panel().querySelectorAll("[data-edit]").forEach(b=>b.onclick=()=>{mgEditing=b.dataset.edit;render();});
  panel().querySelectorAll("[data-remove]").forEach(b=>b.onclick=async()=>{const n=b.dataset.remove;if(!confirm(`Remove ${n} from the team?`))return;EMPLOYEES=EMPLOYEES.filter(e=>e.name!==n);EMPLOYEES.forEach(e=>{if(e.reportsTo===n)e.reportsTo=null;});mgEditing=undefined;rebuildDerived();await saveRoster();buildMeSelect();render();});
  const cancel=document.getElementById("mgCancel");if(cancel)cancel.onclick=()=>{mgEditing=undefined;render();};
  const save=document.getElementById("mgSave");if(save)save.onclick=async()=>{
    const name=document.getElementById("mgName").value.trim();
    if(!name){alert("Please enter a name.");return;}
    const depts=[...panel().querySelectorAll(".mgDept:checked")].map(c=>c.value);
    const rep=document.getElementById("mgReports").value||null;
    const bday=document.getElementById("mgBday").value.trim();
    const person={name,title:document.getElementById("mgTitle").value.trim(),office:document.getElementById("mgOffice").value,depts,reportsTo:(rep===name?null:rep),birthday:bday,type:document.getElementById("mgType").value||undefined,access:document.getElementById("mgAccess").checked};
    if(editing){
      const old=mgEditing;
      const i=EMPLOYEES.findIndex(e=>e.name===old);
      if(i>=0)EMPLOYEES[i]=person;
      if(name!==old)EMPLOYEES.forEach(e=>{if(e.reportsTo===old)e.reportsTo=name;}); // keep reporting lines intact on rename
    } else {
      if(EMPLOYEES.some(e=>e.name===name)){alert("Someone with that name already exists.");return;}
      EMPLOYEES.push(person);
    }
    mgEditing=undefined;rebuildDerived();await saveRoster();buildMeSelect();render();
  };
}


function renderOrgChart(){
  const tagFor=n=>{const t=emp(n).type;return t==='contract'?'<span class="mtag contract">Contract</span>':t==='intern'?'<span class="mtag intern">Intern</span>':'';};
  const titleOf=n=>n.includes('&')?'Co-Founders':(TITLE[n]||'');
  const rowHtml=(name,depth,color)=>`<div class="orow ${depth===0?'lead':''}" style="padding-left:${depth*20}px">${depth>0?`<span class="oconn" style="color:${color}">↳</span>`:''}<div class="obody"><div class="onm">${esc(name)} ${tagFor(name)}</div>${titleOf(name)?`<div class="ott">${esc(titleOf(name))}</div>`:''}</div></div>`;
  const deptBox=dept=>{
    const o=ORG[dept],col=dColor(dept);let rows="";
    if(o.shared){
      rows+=rowHtml(o.heads.join(" & "),0,col);
      o.shared.forEach(n=>rows+=rowHtml(n,1,col));
    } else {
      const walk=(name,depth)=>{rows+=rowHtml(name,depth,col);(o.rep[name]||[]).forEach(c=>walk(c,depth+1));};
      o.heads.forEach(h=>walk(h,0));
    }
    return `<div class="obox"><div class="ohead"><span class="dot" style="background:${col}"></span>${esc(dept)}</div><div class="otree">${rows}</div>${o.note?`<div class="onote">${esc(o.note)}</div>`:''}</div>`;
  };
  panel().innerHTML=`<div class="sectionhead"><h2 class="h-script">Org Chart</h2></div>
    <div class="orgdept-grid">${DEPARTMENTS.map(deptBox).join("")}</div>
    <p class="hint" style="margin-top:20px;text-align:center">Each department is headed by the name at the top; ↳ shows who reports to whom within it. "Contract" and "Intern" tags note non-permanent roles.</p>`;
}

/* ---------- Boot ---------- */
(async()=>{await fbInit();await loadAll();buildMeSelect();render();attachLiveSync();})();
</script>
