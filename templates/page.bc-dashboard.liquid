/* ---------- My Dashboard ---------- */
function renderMyDash(){
  if(!me){panel().innerHTML=`<div class="card empty"><div class="big">Who are you?</div>Pick your name in the top-right to open your personal dashboard.</div>`;return;}
  const newIds=newAssignmentsFor(me).map(a=>a.id);
  const mine=myAssignments(me).slice().sort((a,b)=>{if(a.done!==b.done)return a.done?1:-1;return (a.due||"9999")<(b.due||"9999")?-1:1;});
  const inbox=inboxFor(me);
  const assigned=state.assignments.filter(a=>a.assignedBy===me&&a.assignee!==me).sort((a,b)=>{if(a.done!==b.done)return a.done?1:-1;return (a.due||"9999")<(b.due||"9999")?-1:1;});
  const myKudos=state.kudos.filter(k=>k.to===me).sort((a,b)=>b.ts-a.ts);
  const recHtml=myKudos.length?myKudos.map(k=>`<div class="kudos"><div class="khead"><span class="kstar">★</span> From <b>${esc(k.from)}</b></div><div class="ktext">"${esc(k.text)}"</div><div class="kmeta">${timeAgo(k.ts)}</div></div>`).join(""):`<div class="card empty"><div class="big">No recognition yet</div>Kudos from teammates will appear here.</div>`;
  panel().innerHTML=`
    <div class="card profhead"><div class="avatar">${initials(me)}</div><div><h2>${esc(me)}</h2>${TITLE[me]?`<div class="ptitle" style="margin-top:3px">${esc(TITLE[me])}</div>`:''}<div class="depts">${deptsOf(me).map(d=>`<span class="pill dept"><span class="dot" style="background:${dColor(d)}"></span>${esc(d)}</span>`).join("")}</div></div></div>
    <div class="colcards">
      <div><div class="sectionhead"><h2 class="h-script">My To-Do List</h2></div>${mine.length?mine.map(a=>renderTask(a,newIds.includes(a.id))).join(""):`<div class="card empty"><div class="big">Nothing assigned to you</div>New tasks will appear here.</div>`}</div>
      <div><div class="sectionhead"><h2 class="h-script">My Inbox</h2></div>${inbox.length?inbox.map(renderNote).join(""):`<div class="card empty"><div class="big">Inbox empty</div>Notes from teammates land here.</div>`}</div>
    </div>
    <div class="sectionhead" style="margin-top:30px"><h2 class="h-script">Recognition You've Received</h2>${myKudos.length?`<span class="reccount">${myKudos.length}</span>`:''}</div>
    ${recHtml}
    <div class="sectionhead" style="margin-top:30px"><h2 class="h-script">Tasks I've Assigned</h2></div>
    <div class="card">${assigned.length?assigned.map(a=>renderTask(a,false)).join(""):`<div class="empty"><div class="big">You haven't assigned anything yet</div>Tasks you assign to others — and whether they're done — will show up here.</div>`}</div>`;
  wireTasks();wireNotes();markAssignmentsSeen(me);markNotesSeen(me);renderSidebar();
}

/* ---------- Sticky notes ---------- */
function renderNote(n){
  const other=(n.from===me)?n.to:n.from;
  const unread=noteUnread(n,me);
  const entries=[{from:n.from,text:n.text,ts:n.ts}].concat(n.replies||[]);
  const body=entries.map(e=>`<div class="nentry ${e.from===me?'mine':''}"><div class="rm">${esc(e.from)} · ${timeAgo(e.ts)}</div><p>${esc(e.text)}</p></div>`).join("");
  return `<div class="note ${unread?'unread':''}"><div class="nmeta">Conversation with ${esc(other)}${unread?' <span class="newtag">New</span>':''}</div>
    <div class="nthread">${body}</div>
    <div class="nactions"><input type="text" placeholder="Reply…" data-rin="${n.id}"><button class="nbtn" data-reply="${n.id}">Reply</button><button class="nbtn dismiss" data-dismiss="${n.id}">Dismiss</button></div></div>`;
}
function wireNotes(){
  panel().querySelectorAll("[data-reply]").forEach(b=>b.onclick=async()=>{const inp=panel().querySelector(`[data-rin="${b.dataset.reply}"]`);const v=inp.value.trim();if(!v)return;const n=state.notes.find(x=>x.id===b.dataset.reply);n.replies=n.replies||[];n.replies.push({from:me||'someone',text:v,ts:Date.now()});n.hiddenFor=[];n.seen=n.seen||{};n.seen[me]=Date.now();await saveNotes();render();});
  panel().querySelectorAll("[data-dismiss]").forEach(b=>b.onclick=async()=>{const n=state.notes.find(x=>x.id===b.dataset.dismiss);n.hiddenFor=n.hiddenFor||[];if(!n.hiddenFor.includes(me))n.hiddenFor.push(me);await saveNotes();render();});
}

/* ---------- Assignments ---------- */
function renderAssignments(){
  const opts=arr=>arr.map(x=>`<option value="${esc(x)}">${esc(x)}</option>`).join("");
  let list=state.assignments.slice();
  if(filterDept)list=list.filter(a=>a.dept===filterDept);
  if(filterPerson)list=list.filter(a=>a.assignee===filterPerson);
  const sortFn=(a,b)=>{if(a.done!==b.done)return a.done?1:-1;return (a.due||"9999")<(b.due||"9999")?-1:1;};
  const grouped=!filterDept&&!filterPerson;
  let body="";
  if(!list.length){body=`<div class="card empty"><div class="big">No assignments here</div>Add one above${(filterDept||filterPerson)?', or clear the filters':''}.</div>`;}
  else if(grouped){
    DEPARTMENTS.concat(["__none__"]).forEach(d=>{
      const items=list.filter(a=>(d==="__none__"?!a.dept:a.dept===d)).sort(sortFn);
      if(!items.length)return;
      const open=items.filter(a=>!a.done).length;
      const label=d==="__none__"?"Unsorted":d;
      body+=`<div class="grouphead"><span class="gname" style="color:${d==="__none__"?'var(--muted)':dColor(d)}">${esc(label)}</span><span class="rem">${open} remaining</span></div>`;
      body+=items.map(a=>renderTask(a,false)).join("");
    });
  } else { body=list.sort(sortFn).map(a=>renderTask(a,false)).join(""); }
  panel().innerHTML=`
    <div class="card composer"><div class="eyebrow">— Add an assignment —</div>
      <input type="text" id="aT" placeholder="What needs doing?">
      <div class="mt"><textarea id="aD" placeholder="Notes (optional)…"></textarea></div>
      <div class="row mt">
        <div class="col"><label class="fld">Assign to</label><select class="in" id="aWho"><option value="">— Person —</option>${opts(EMPLOYEES.filter(ACCESS).map(e=>e.name))}</select></div>
        <div class="col"><label class="fld">Department</label><select class="in" id="aDept"><option value="">— Optional —</option>${opts(DEPARTMENTS)}</select></div>
        <div class="col"><label class="fld">Due date</label><input type="date" id="aDue"></div>
        <div class="col"><label class="fld">Repeat</label><select class="in" id="aRecur"><option value="">One-time</option><option value="WEEKLY">Weekly</option><option value="BIWEEKLY">Every 2 weeks</option><option value="MONTHLY">Monthly</option><option value="QUARTERLY">Quarterly</option><option value="YEARLY">Yearly</option></select></div>
        <div style="flex:0 0 auto"><button class="btn" id="aAdd">+ Add task</button></div>
      </div>
      <div class="priorityhint" id="pHint"></div>
    </div>
    <div class="sectionhead">
      <h2 class="h-script">${filterDept?esc(filterDept):filterPerson?esc(filterPerson)+"'s tasks":"All Assignments"}</h2>
      <button class="btn outline sm" id="clearDone">Clear completed</button>
    </div>
    <div class="filters">
      <select id="fDept"><option value="">All departments</option>${DEPARTMENTS.map(d=>`<option value="${esc(d)}" ${filterDept===d?'selected':''}>${esc(d)}</option>`).join("")}</select>
      <select id="fPerson"><option value="">Everyone</option>${EMPLOYEES.filter(ACCESS).map(e=>`<option value="${e.name}" ${filterPerson===e.name?'selected':''}>${e.name}</option>`).join("")}</select>
    </div>
    ${body}`;
  const due=document.getElementById("aDue"),hint=document.getElementById("pHint");
  due.onchange=()=>{const v=due.value;hint.textContent=(v&&["over","today","soon"].includes(dueState(v,false)))?"High priority — due within 3 days.":"";};
  document.getElementById("aAdd").onclick=async()=>{const t=document.getElementById("aT").value.trim();if(!t)return;state.assignments.push({id:uid(),title:t,desc:document.getElementById("aD").value.trim(),assignee:document.getElementById("aWho").value,dept:document.getElementById("aDept").value,due:due.value,recur:document.getElementById("aRecur").value,done:false,doneBy:null,assignedBy:me,ts:Date.now()});await saveAssign();render();};
  document.getElementById("fDept").onchange=e=>{filterDept=e.target.value;render();};
  document.getElementById("fPerson").onchange=e=>{filterPerson=e.target.value;render();};
  document.getElementById("clearDone").onclick=async()=>{const n=state.assignments.filter(a=>a.done).length;if(!n)return;if(!confirm(`Clear ${n} completed assignment${n>1?'s':''}?`))return;state.assignments=state.assignments.filter(a=>!a.done);await saveAssign();render();};
  wireTasks();
}

/* ---------- Team ---------- */
function renderTeam(){
  const officeClass=o=>o==='Dallas WTC'?'dallas':o==='Remote'?'remote':o==='Flex'?'flex':'bchq';
  const officeChip=n=>{const o=emp(n).office;return o?`<span class="poffice ${officeClass(o)}"><span class="pin">📍</span>${esc(o)}</span>`:'';};
  const orderedDepts=DEPARTMENTS.map((d,i)=>({d,i,n:peopleIn(d).length})).sort((a,b)=>b.n-a.n||a.i-b.i).map(x=>x.d);
  panel().innerHTML=`<div class="sectionhead"><h2 class="h-script">Team & Departments</h2></div>
