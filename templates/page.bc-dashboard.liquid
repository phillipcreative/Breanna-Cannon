{% layout none %}
{% raw %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Brianna Cannon — Company Dashboard</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap" rel="stylesheet">
<style>
  :root{
    --display:"Playfair Display",Georgia,serif;
    --body:"Cormorant Garamond",Georgia,serif;
    --ink:#16172B; --ink-soft:#43445C; --muted:#8B8BA3;
    --bg:#F4F3F8; --surface:#FFFFFF; --line:#E8E6F0; --line-soft:#F0EEF6;
    --band:#16172B; --accent:#8B6DD4; --accent-soft:#EEEAF8;
    --done:#3FA877; --over:#D85A3C; --high-bg:#FBE7DD; --high-tx:#C2502E;
    --note:#FFF8E6; --note-line:#F1E4BB;
    --radius:11px; --shadow:0 1px 2px rgba(22,23,43,.05),0 8px 26px rgba(22,23,43,.06);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{background:var(--bg);color:var(--ink);font-family:var(--body);font-size:17px;line-height:1.45;-webkit-font-smoothing:antialiased;}
  .caps{text-transform:uppercase;letter-spacing:.22em;}

  /* Masthead */
  header.mast{background:linear-gradient(95deg,#F8CBA6 0%,#FBE5A6 16%,#F2EE9E 28%,#CBEBAF 42%,#B6E6DF 56%,#BAD6F2 70%,#D6C8F1 84%,#F4C8E2 100%);}
  .mast-inner{max-width:1180px;margin:0 auto;padding:30px 34px;display:flex;justify-content:space-between;align-items:flex-start;gap:24px;flex-wrap:wrap;}
  .mast .title{font-family:var(--display);font-weight:700;font-size:34px;letter-spacing:.06em;color:var(--ink);line-height:1;cursor:text;}
  .mast .title:hover{opacity:.75;}
  .mast .subtitle{font-size:15px;color:var(--ink);font-weight:600;letter-spacing:.16em;margin-top:10px;}
  .mast .tagline{font-family:var(--display);font-style:italic;font-weight:500;font-size:17px;color:var(--muted);margin-top:8px;}
  .mast-right{text-align:right;display:flex;flex-direction:column;align-items:flex-end;gap:3px;}
  .mast-right .dayname{font-size:13px;font-weight:600;color:var(--ink);}
  .mast-right .datefull{font-size:13px;color:var(--ink-soft);}
  .whoami{margin-top:12px;display:flex;align-items:center;gap:8px;font-size:12px;color:var(--ink-soft);}
  .whoami select{font-family:var(--body);font-size:15px;color:var(--ink);background:rgba(255,255,255,.55);border:1px solid rgba(22,23,43,.18);border-radius:8px;padding:6px 10px;cursor:pointer;}
  .whoami select:focus{outline:none;border-color:var(--ink);}

  /* Scripture banner */
  .verseband{background:var(--band);}
  .verseband-inner{max-width:1180px;margin:0 auto;padding:15px 34px;display:flex;align-items:baseline;justify-content:flex-end;gap:16px;text-align:right;flex-wrap:wrap;}
  .verse-ref{font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:#EC6BA0;font-weight:600;flex-shrink:0;}
  .verse-text{font-family:var(--display);font-style:italic;font-size:18px;color:#fff;font-weight:500;}

  /* Shell */
  .shell{max-width:1180px;margin:0 auto;display:flex;align-items:flex-start;gap:0;}
  .sidebar{width:248px;flex-shrink:0;padding:26px 18px;position:sticky;top:0;align-self:flex-start;}
  .main{flex:1;min-width:0;padding:26px 34px 80px 22px;}
  .navhead{font-size:11px;color:var(--muted);margin:18px 12px 8px;}
  .navhead:first-child{margin-top:0;}
  .navitem{display:flex;align-items:center;gap:11px;padding:9px 12px;border-radius:9px;cursor:pointer;color:var(--ink-soft);font-size:14px;letter-spacing:.04em;}
  .navitem .ico{width:17px;height:17px;flex-shrink:0;color:var(--muted);display:flex;}
  .navitem .ico svg{width:17px;height:17px;stroke:currentColor;fill:none;stroke-width:1.5;}
  .navitem .nm{flex:1;text-transform:uppercase;letter-spacing:.1em;font-size:12.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .navitem .ct{font-size:13px;color:var(--muted);font-family:var(--display);}
  .navitem .ct.alert{color:var(--over);font-weight:600;}
  .navitem:hover{background:var(--line-soft);color:var(--ink);}
  .navitem.active{background:var(--accent-soft);color:var(--ink);}
  .navitem.active .ico,.navitem.active .ct{color:var(--accent);}
  .deptitem .dot{width:11px;height:11px;border-radius:50%;flex-shrink:0;}
  .deptitem .nm{text-transform:none;letter-spacing:.01em;font-size:13.5px;}

  /* Cards / shared */
  .card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);}
  .eyebrow{font-style:italic;color:var(--muted);font-size:15px;letter-spacing:.16em;text-transform:uppercase;text-align:center;margin-bottom:16px;}
  .h-script{font-family:var(--display);font-style:italic;font-size:26px;font-weight:600;color:var(--ink);margin:0;}
  .sectionhead{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;margin:4px 2px 14px;}
  .composer{padding:22px 24px;margin-bottom:26px;}
  label.fld{display:block;font-size:12px;color:var(--muted);margin-bottom:5px;text-transform:uppercase;letter-spacing:.12em;}
  input[type=text],input[type=date],textarea,select.in{width:100%;font-family:var(--body);font-size:16px;color:var(--ink);background:var(--surface);border:none;border-bottom:1px solid var(--line);border-radius:0;padding:9px 2px;}
  input::placeholder,textarea::placeholder{font-style:italic;color:#B7B7C9;}
  input:focus,textarea:focus,select.in:focus{outline:none;border-bottom-color:var(--accent);}
  select.in{cursor:pointer;}
  textarea{resize:vertical;min-height:46px;}
  .row{display:flex;gap:18px;flex-wrap:wrap;align-items:flex-end;}
  .row>.col{flex:1;min-width:150px;}
  .mt{margin-top:16px;}
  .btn{appearance:none;cursor:pointer;font-family:var(--body);font-size:14px;letter-spacing:.14em;text-transform:uppercase;background:var(--band);color:#fff;border:none;border-radius:8px;padding:13px 22px;}
  .btn:hover{background:#262741;}
  .btn:disabled{background:var(--line);color:var(--muted);cursor:not-allowed;}
  .btn.outline{background:transparent;color:var(--muted);border:1px solid var(--line);}
  .btn.outline:hover{border-color:var(--accent);color:var(--accent);}
  .btn.sm{padding:9px 14px;font-size:12px;}
  .priorityhint{color:var(--over);font-style:italic;font-size:15px;margin-top:14px;min-height:1px;}
  .del{appearance:none;background:none;border:none;color:#C4C4D2;cursor:pointer;font-size:12px;letter-spacing:.1em;text-transform:uppercase;padding:4px;}
  .del:hover{color:var(--over);}

  /* Task rows */
  .grouphead{display:flex;align-items:flex-end;justify-content:space-between;margin:26px 2px 10px;}
  .grouphead .gname{font-family:var(--display);font-style:italic;font-size:21px;font-weight:600;}
  .grouphead .rem{font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.14em;}
  .task{display:flex;gap:14px;align-items:flex-start;background:var(--surface);border:1px solid var(--line);border-left:4px solid var(--accent);border-radius:9px;padding:15px 18px;margin-bottom:10px;box-shadow:var(--shadow);}
  .check{flex-shrink:0;width:22px;height:22px;border:2px solid #CFCDE0;border-radius:6px;cursor:pointer;display:flex;align-items:center;justify-content:center;margin-top:2px;background:var(--surface);transition:all .15s;}
  .check:hover{border-color:var(--accent);}
  .check.on{background:var(--accent);border-color:var(--accent);}
  .check.on svg{display:block;} .check svg{display:none;width:12px;height:12px;stroke:#fff;stroke-width:3;fill:none;}
  .task .body{flex:1;min-width:0;}
  .task .head{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;}
  .task .title{font-size:19px;color:var(--ink);}
  .task.done .title{text-decoration:line-through;color:var(--muted);}
  .task .desc{font-size:15px;color:var(--ink-soft);margin-top:3px;}
  .task .pills{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:11px;}
  .pill{font-size:12px;letter-spacing:.08em;text-transform:uppercase;border-radius:6px;padding:4px 9px;display:inline-flex;align-items:center;gap:6px;background:var(--line-soft);color:var(--muted);}
  .pill .cal{width:11px;height:11px;stroke:currentColor;fill:none;stroke-width:1.3;}
  .pill.high{background:var(--high-bg);color:var(--high-tx);font-weight:600;}
  .pill.due.over{background:var(--high-bg);color:var(--high-tx);}
  .pill.due.today{background:#FCEFD8;color:#9A6B16;}
  .pill.who{background:var(--accent-soft);color:#6A4FB0;text-transform:none;letter-spacing:.02em;}
  .pill.dept{text-transform:none;letter-spacing:.02em;}
  .pill.dept .dot{width:8px;height:8px;border-radius:50%;}
  .pill.doneby{background:#E7F6EE;color:var(--done);text-transform:none;letter-spacing:.02em;}
  .newtag{font-size:10px;font-weight:600;letter-spacing:.12em;color:#fff;background:var(--over);border-radius:5px;padding:2px 7px;text-transform:uppercase;margin-left:8px;vertical-align:middle;}

  /* Filters */
  .filters{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:8px;}
  .filters select{font-family:var(--body);font-size:14px;color:var(--ink);background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:9px 12px;cursor:pointer;}

  /* Team */
  .deptgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:18px;}
  .deptcard{padding:18px 20px;}
  .deptcard h3{font-family:var(--display);font-style:italic;font-size:19px;font-weight:600;margin:0 0 12px;display:flex;align-items:center;gap:9px;}
  .deptcard h3 .dot{width:11px;height:11px;border-radius:50%;}
  .person{display:flex;align-items:center;gap:11px;padding:9px 0;border-top:1px solid var(--line-soft);cursor:pointer;}
  .person:hover .pname{color:var(--accent);}
  .avatar{width:32px;height:32px;border-radius:50%;background:var(--accent-soft);color:#6A4FB0;font-family:var(--display);font-weight:600;font-size:14px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
  .pname{font-size:16px;}
  .poffice{margin-left:auto;flex-shrink:0;display:inline-flex;align-items:center;gap:3px;font-size:11px;letter-spacing:.04em;text-transform:uppercase;font-family:var(--display);font-weight:600;padding:3px 9px;border-radius:999px;white-space:nowrap;}
  .poffice .pin{font-size:10px;opacity:.7;}
  .poffice.bchq{background:#F3E9FB;color:#7A3FC4;}
  .poffice.dallas{background:#E9F3FB;color:#2C6FB0;}
  .poffice.remote{background:#EFEFEC;color:#7B7768;}
  .poffice.flex{background:#FBF1E9;color:#B06A2C;}

  /* Profile + greeting */
  .profhead{display:flex;align-items:center;gap:18px;padding:22px 24px;margin-bottom:22px;}
  .profhead .avatar{width:62px;height:62px;font-size:24px;}
  .profhead h2{font-family:var(--display);font-size:30px;font-weight:600;margin:0;}
  .profhead .depts{display:flex;gap:7px;flex-wrap:wrap;margin-top:9px;}
  .back{appearance:none;background:none;border:none;color:var(--accent);font-family:var(--body);font-size:15px;cursor:pointer;padding:0;margin-bottom:14px;letter-spacing:.04em;}
  .colcards{display:grid;grid-template-columns:1fr 1fr;gap:24px;}
  @media(max-width:780px){.colcards{grid-template-columns:1fr;}}
  .greet{padding:22px 26px;margin-bottom:26px;display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap;}
  .greet .g-name{font-family:var(--display);font-style:italic;font-size:24px;font-weight:600;}
  .greet .g-sub{font-size:16px;color:var(--ink-soft);margin-top:4px;}

  /* Items / news / questions */
  .item{padding:18px 22px;border-top:1px solid var(--line-soft);}
  .item:first-child{border-top:none;}
  .item .head{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;}
  .item h3{font-family:var(--display);font-size:20px;font-weight:600;margin:0;}
  .item .meta{font-size:13px;color:var(--muted);font-style:italic;margin-top:3px;}
  .item p{margin:8px 0 0;color:var(--ink-soft);font-size:16px;}
  .replies{margin-top:13px;padding-left:14px;border-left:2px solid var(--line);display:flex;flex-direction:column;gap:11px;}
  .reply .meta{font-size:12px;color:var(--muted);font-style:italic;}
  .reply p{margin:2px 0 0;font-size:15px;color:var(--ink-soft);}
  .replybox{display:flex;gap:10px;margin-top:14px;align-items:center;}
  .replybox input{flex:1;border:1px solid var(--line);border-radius:8px;padding:9px 12px;}

  /* Sticky notes */
  .note{background:var(--note);border:1px solid var(--note-line);border-radius:11px;padding:16px 18px;margin-bottom:15px;box-shadow:0 3px 12px rgba(150,120,30,.09);}
  .note .nmeta{font-size:12px;color:#9A8438;font-style:italic;letter-spacing:.04em;}
  .note .ntext{margin:7px 0 0;color:#5A5024;font-size:16px;}
  .note .nreplies{margin-top:11px;padding-left:12px;border-left:2px solid var(--note-line);display:flex;flex-direction:column;gap:8px;}
  .note .nreply .rm{font-size:11px;color:#9A8438;font-style:italic;}
  .note .nreply p{margin:1px 0 0;font-size:15px;color:#5A5024;}
  .note .nactions{display:flex;gap:9px;margin-top:13px;align-items:center;}
  .note .nactions input{flex:1;background:rgba(255,255,255,.75);border:1px solid var(--note-line);border-radius:8px;padding:8px 11px;font-size:15px;}
  .nbtn{appearance:none;cursor:pointer;font-family:var(--body);font-size:12px;letter-spacing:.1em;text-transform:uppercase;border-radius:7px;padding:9px 13px;border:1px solid var(--note-line);background:rgba(255,255,255,.7);color:#8A7528;}
  .nbtn.dismiss{background:#fff;} .nbtn:hover{border-color:#C9A93A;}

  /* Progress */
  .breakdown{padding:22px 24px;margin-bottom:22px;}
  .breakdown h2{font-family:var(--display);font-style:italic;font-size:20px;font-weight:600;margin:0 0 16px;}
  .prow{display:flex;align-items:center;gap:14px;padding:10px 0;border-top:1px solid var(--line-soft);}
  .prow:first-of-type{border-top:none;}
  .prow .who{font-size:15px;width:170px;flex-shrink:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:flex;align-items:center;gap:9px;}
  .prow .dot{width:9px;height:9px;border-radius:50%;}
  .prow .track{flex:1;height:7px;background:var(--line-soft);border-radius:999px;overflow:hidden;}
  .prow .fill{height:100%;border-radius:999px;background:var(--done);}
  .prow .frac{font-size:13px;color:var(--muted);width:48px;text-align:right;flex-shrink:0;font-family:var(--display);}

  .empty{padding:42px 20px;text-align:center;color:var(--muted);}
  .empty .big{font-family:var(--display);font-style:italic;font-size:19px;color:var(--ink);margin-bottom:5px;}
  .hint{font-size:14px;color:var(--muted);font-style:italic;}

  @media(max-width:860px){
    .shell{flex-direction:column;}
    .sidebar{width:100%;position:static;display:flex;flex-wrap:wrap;gap:6px;padding:16px 22px;border-bottom:1px solid var(--line);}
    .navhead{width:100%;margin:6px 4px 2px;}
    .navitem{flex:0 0 auto;}
    .main{padding:22px;width:100%;}
    .statcell .n{font-size:24px;}
  }
  @media(max-width:560px){.statband-inner{flex-wrap:wrap;}.statcell{flex:1 0 33%;}}

  /* Newsletter / featured */
  .featgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px;}
  .feat{overflow:hidden;display:flex;flex-direction:column;}
  .feat .thumb{height:150px;background:var(--accent-soft);display:flex;align-items:center;justify-content:center;overflow:hidden;}
  .feat .thumb img{width:100%;height:100%;object-fit:cover;}
  .feat .thumb .doc{font-family:var(--display);font-style:italic;font-size:42px;color:var(--accent);}
  .feat .fbody{padding:14px 16px;flex:1;display:flex;flex-direction:column;gap:4px;}
  .feat .ftitle{font-family:var(--display);font-size:18px;font-weight:600;}
  .feat .fmeta{font-size:12px;color:var(--muted);font-style:italic;}
  .feat .flinks{display:flex;gap:14px;margin-top:8px;}
  .feat .flinks a{color:var(--accent);font-size:14px;letter-spacing:.04em;text-decoration:none;border-bottom:1px solid transparent;}
  .feat .flinks a:hover{border-bottom-color:var(--accent);}
  .feat .del{align-self:flex-start;margin-top:6px;}

  /* Kudos wall */
  .kudos{background:linear-gradient(135deg,#FFF4F9,#F3EEFB);border:1px solid #F0E2EE;border-radius:11px;padding:16px 18px;margin-bottom:14px;}
  .reccount{display:inline-flex;align-items:center;justify-content:center;min-width:24px;height:24px;padding:0 7px;margin-left:10px;border-radius:999px;background:linear-gradient(135deg,#EC6BA0,#9A4F86);color:#fff;font-family:var(--display);font-weight:600;font-size:13px;vertical-align:middle;}
  .mgform{margin-bottom:18px;}
  .mgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;}
  .mgchecks{display:flex;flex-wrap:wrap;gap:10px 18px;margin-top:8px;}
  .mgchk{display:inline-flex;align-items:center;gap:7px;font-size:15px;cursor:pointer;}
  .mgchk input{width:16px;height:16px;accent-color:var(--accent);}
  .mgrow{display:flex;align-items:center;gap:12px;padding:10px 0;border-top:1px solid var(--line-soft);}
  .mgrow:first-child{border-top:none;}
  .mgacts{margin-left:auto;display:flex;gap:8px;flex-shrink:0;}
  .btn.ghost{background:transparent;color:var(--muted);border:1px solid var(--line);}
  .note.unread{box-shadow:0 0 0 2px var(--accent-soft);}
  .newtag{display:inline-block;margin-left:8px;font-family:var(--display);font-size:11px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:#fff;background:var(--over);padding:2px 8px;border-radius:999px;vertical-align:middle;}
  .nthread{display:flex;flex-direction:column;gap:9px;margin:10px 0 4px;}
  .nentry{background:var(--paper);border:1px solid var(--line-soft);border-radius:11px;padding:9px 13px;max-width:88%;align-self:flex-start;}
  .nentry.mine{background:#FBEFF5;border-color:#F2D7E5;align-self:flex-end;}
  .nentry .rm{font-size:11px;color:var(--muted);font-style:italic;margin-bottom:3px;}
  .nentry p{margin:0;font-size:15px;}
  .evrow{display:flex;align-items:center;gap:12px;padding:11px 0;border-top:1px solid var(--line-soft);}
  .evrow:first-of-type{border-top:none;}
  .evdot{width:10px;height:10px;border-radius:50%;flex-shrink:0;}
  .evdot.event{background:var(--accent);}
  .evdot.milestone{background:#E0A52A;}
  .evinfo{display:flex;flex-direction:column;min-width:0;}
  .evttl{font-size:16px;}
  .evsub{font-size:12px;color:var(--muted);font-style:italic;}
  .gcalbtn{margin-left:auto;flex-shrink:0;font-size:13px;font-family:var(--display);font-weight:600;color:var(--accent);border:1px solid var(--line);border-radius:999px;padding:6px 13px;text-decoration:none;white-space:nowrap;}
  .gcalbtn:hover{background:var(--accent-soft);}
  .pill.recur{background:#EFEAFB;color:#6A4FB0;}
  .lastdone{font-size:12px;color:var(--muted);font-style:italic;margin-top:7px;}
  .kudos .khead{font-family:var(--display);font-style:italic;font-size:17px;color:#9A4F86;}
  .kudos .khead b{font-weight:600;font-style:normal;}
  .kudos .ktext{margin:6px 0 0;color:var(--ink-soft);font-size:16px;}
  .kudos .kmeta{font-size:12px;color:var(--muted);font-style:italic;margin-top:7px;}
  .kstar{color:#E0A93B;}

  /* Upcoming */
  .upcoming{padding:18px 22px;margin-bottom:26px;}
  .upcoming h2{font-family:var(--display);font-style:italic;font-size:19px;margin:0 0 12px;}
  .urow{display:flex;align-items:center;gap:12px;padding:8px 0;border-top:1px solid var(--line-soft);}
  .urow:first-of-type{border-top:none;}
  .urow .uicon{font-size:18px;width:24px;text-align:center;}
  .urow .ulabel{flex:1;font-size:16px;}
  .urow .uwhen{font-size:13px;color:var(--muted);font-style:italic;}

  /* Calendar */
  .calbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;gap:12px;flex-wrap:wrap;}
  .calbar .mlabel{font-family:var(--display);font-style:italic;font-size:24px;font-weight:600;}
  .calnav{display:flex;gap:8px;}
  .calnav button{appearance:none;cursor:pointer;font-family:var(--body);font-size:14px;background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:8px 14px;color:var(--ink);}
  .calnav button:hover{border-color:var(--accent);color:var(--accent);}
