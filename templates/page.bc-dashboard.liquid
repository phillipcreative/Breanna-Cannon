const myAssignments=p=>state.assignments.filter(a=>a.assignee===p);
const newAssignmentsFor=p=>{const s=state.seen[p]||[];return myAssignments(p).filter(a=>!a.done&&!s.includes(a.id));};
const noteLastTs=n=>{const r=(n.replies&&n.replies.length)?n.replies[n.replies.length-1].ts:0;return Math.max(n.ts||0,r||0);};
const noteLastAuthor=n=>(n.replies&&n.replies.length)?n.replies[n.replies.length-1].from:n.from;
const noteHidden=(n,p)=>(n.hiddenFor&&n.hiddenFor.includes(p))||(n.dismissed&&!n.hiddenFor&&p===n.to);
const noteUnread=(n,p)=>noteLastAuthor(n)!==p&&noteLastTs(n)>((n.seen&&n.seen[p])||0);
const inboxFor=p=>state.notes.filter(x=>(x.to===p||x.from===p)&&!noteHidden(x,p)).sort((a,b)=>noteLastTs(b)-noteLastTs(a));
const inboxUnread=p=>inboxFor(p).filter(n=>noteUnread(n,p)).length;
function markNotesSeen(p){if(!p)return;let changed=false;state.notes.forEach(n=>{if((n.to===p||n.from===p)&&!noteHidden(n,p)){n.seen=n.seen||{};const lt=noteLastTs(n);if((n.seen[p]||0)!==lt){n.seen[p]=lt;changed=true;}}});if(changed)saveNotes();}
function markAssignmentsSeen(p){if(!p)return;state.seen[p]=myAssignments(p).map(a=>a.id);saveSeen();}

/* ---------- Masthead / stat band / sidebar ---------- */
function renderMast(){
  document.getElementById("company").textContent=state.company;
  document.getElementById("dayName").textContent=new Date().toLocaleDateString(undefined,{weekday:'long'});
  document.getElementById("dateFull").textContent=new Date().toLocaleDateString(undefined,{month:'long',day:'numeric',year:'numeric'});
}
function buildMeSelect(){
  const sel=document.getElementById("meSelect");
  sel.innerHTML=`<option value="">Pick your name…</option>`+EMPLOYEES.filter(ACCESS).map(e=>`<option value="${e.name}" ${e.name===me?'selected':''}>${e.name}</option>`).join("");
  sel.onchange=async()=>{me=sel.value;await dbSet("bc:me",me,false);render();};
}
function renderSidebar(){
  const attn=me?(newAssignmentsFor(me).length+inboxUnread(me)):0;
  const openCt=state.assignments.filter(x=>!x.done).length;
  const cnt={home:"",mydash:attn,assignments:openCt,calendar:"",team:"",orgchart:"",progress:"",questions:state.questions.length};
  let html=`<div class="navhead caps">Views</div>`;
  html+=VIEWS.map(([id,label])=>{
    const c=cnt[id], alert=(id==='mydash'&&attn>0);
    return `<div class="navitem ${activeView===id?'active':''}" data-view="${id}"><span class="ico">${ICON[id]}</span><span class="nm">${label}</span>${c!==""?`<span class="ct ${alert?'alert':''}">${c}</span>`:""}</div>`;
  }).join("");
  if(isAdmin())html+=`<div class="navitem ${activeView==='manage'?'active':''}" data-view="manage"><span class="ico">${ICON.manage}</span><span class="nm">Manage Team</span></div>`;
  html+=`<div class="navhead caps">Departments</div>`;
  html+=DEPARTMENTS.map(d=>{const open=state.assignments.filter(a=>a.dept===d&&!a.done).length;
    return `<div class="navitem deptitem ${(activeView==='assignments'&&filterDept===d)?'active':''}" data-dept="${esc(d)}"><span class="dot" style="background:${dColor(d)}"></span><span class="nm">${esc(d)}</span><span class="ct">${open||""}</span></div>`;}).join("");
  const sb=document.getElementById("sidebar");
  sb.innerHTML=html;
  sb.querySelectorAll("[data-view]").forEach(el=>el.onclick=()=>{activeView=el.dataset.view;profileView=null;mgEditing=undefined;if(el.dataset.view!=='assignments'){filterDept="";filterPerson="";}render();});
  sb.querySelectorAll("[data-dept]").forEach(el=>el.onclick=()=>{activeView='assignments';profileView=null;filterDept=el.dataset.dept;filterPerson="";render();});
}
document.getElementById("company").addEventListener("click",async()=>{const v=prompt("Hub name:",state.company);if(v&&v.trim()){state.company=v.trim();await dbSet("bc:company",state.company);renderMast();}});

const panel=()=>document.getElementById("panel");
function render(){
  renderMast();renderSidebar();
  if(activeView==="home")renderHome();
  else if(activeView==="mydash")renderMyDash();
  else if(activeView==="assignments")renderAssignments();
  else if(activeView==="calendar")renderCalendar();
  else if(activeView==="team")profileView?renderProfile(profileView):renderTeam();
  else if(activeView==="orgchart")renderOrgChart();
  else if(activeView==="progress")renderProgress();
  else if(activeView==="manage")renderManage();
  else renderQuestions();
}

/* ---------- Task row ---------- */
const CAL='<svg class="cal" viewBox="0 0 16 16"><rect x="2" y="3" width="12" height="11" rx="1.5"/><path d="M2 6.5h12M5 1.5v3M11 1.5v3"/></svg>';
function duePill(a){
  if(!a.due)return"";
  const ds=dueState(a.due,a.done);let label;
  if(a.done)label="Done";else if(ds==="over")label="Overdue · "+fmtDate(a.due);else if(ds==="today")label="Due today · "+fmtDate(a.due);else label="Due · "+fmtDate(a.due);
  return `<span class="pill due ${ds}">${CAL}${label}</span>`;
}
function renderTask(a,isNew){
  const border=a.dept?dColor(a.dept):"#CFCDE0";
  return `<div class="task ${a.done?'done':''}" style="border-left-color:${border}">
    <div class="check ${a.done?'on':''}" data-toggle="${a.id}" role="checkbox" aria-checked="${a.done}" tabindex="0" title="Mark complete"><svg viewBox="0 0 14 14"><polyline points="2,7 6,11 12,3"></polyline></svg></div>
    <div class="body"><div class="head"><span class="title">${esc(a.title)}${isNew?'<span class="newtag">New</span>':''}</span><button class="del" data-del="${a.id}">Delete</button></div>
    ${a.desc?`<div class="desc">${esc(a.desc)}</div>`:""}
    <div class="pills">
      ${isHigh(a)?'<span class="pill high">High</span>':""}
      ${a.recur?`<span class="pill recur">↻ ${esc(recurShort(a.recur))}</span>`:""}
      ${a.assignee?`<span class="pill who">${esc(a.assignee)}</span>`:""}
      ${a.dept?`<span class="pill dept"><span class="dot" style="background:${dColor(a.dept)}"></span>${esc(a.dept)}</span>`:""}
      ${duePill(a)}
      ${a.done?`<span class="pill doneby">✓ done by ${esc(a.doneBy||'someone')}</span>`:""}
    </div>${a.recur&&a.lastDoneTs?`<div class="lastdone">✓ Last completed ${timeAgo(a.lastDoneTs)} by ${esc(a.lastDoneBy||'someone')}</div>`:""}</div></div>`;
}
function wireTasks(){
  const toggle=async id=>{const a=state.assignments.find(x=>x.id===id);if(!a)return;
    if(a.recur&&!a.done){a.due=advanceTaskDue(a.due,a.recur);a.lastDoneBy=me||'someone';a.lastDoneTs=Date.now();a.done=false;a.doneBy=null;}
    else{a.done=!a.done;a.doneBy=a.done?(me||'someone'):null;}
    await saveAssign();render();};
  panel().querySelectorAll("[data-toggle]").forEach(c=>{c.onclick=()=>toggle(c.dataset.toggle);c.onkeydown=e=>{if(e.key===" "||e.key==="Enter"){e.preventDefault();toggle(c.dataset.toggle);}};});
  panel().querySelectorAll(".task [data-del]").forEach(b=>b.onclick=async()=>{if(!confirm("Delete this assignment?"))return;state.assignments=state.assignments.filter(a=>a.id!==b.dataset.del);await saveAssign();render();});
}

/* ---------- Home ---------- */
function isImageUrl(u){return /\.(png|jpe?g|gif|webp|svg|avif)(\?|#|$)/i.test(u||"");}
function renderHome(){
  const feed=state.news.slice().sort((a,b)=>b.ts-a.ts);
  const feat=state.featured.slice().sort((a,b)=>b.ts-a.ts);
  const kud=state.kudos.slice().sort((a,b)=>b.ts-a.ts);
  const up=upcomingItems(30);
  let greet;
  if(me){const open=myAssignments(me).filter(a=>!a.done).length,inb=inboxUnread(me),nw=newAssignmentsFor(me).length;
    const bits=[];if(open)bits.push(`${open} open task${open>1?'s':''}`);if(inb)bits.push(`${inb} note${inb>1?'s':''} waiting`);
    greet=`<div class="card greet"><div><div class="g-name">Hello, ${esc(String(me).split(" ")[0])}.</div><div class="g-sub">${bits.length?bits.join(" · "):"You're all caught up."}${nw?` · <strong style="color:var(--over)">${nw} new</strong>`:""}</div></div><button class="btn" id="toMine">Open my dashboard</button></div>`;
  } else greet=`<div class="card greet"><div><div class="g-name">Welcome to the BC Dashboard.</div><div class="g-sub">Choose your name, top right, to see your tasks and notes.</div></div></div>`;

  const upHtml = up.length?`<div class="card upcoming"><h2>Upcoming</h2>${up.map(u=>`<div class="urow"><span class="uicon">${u.icon}</span><span class="ulabel">${esc(u.label)}</span><span class="uwhen">${esc(u.when)}</span></div>`).join("")}</div>`:"";

  const featHtml = feat.length?`<div class="featgrid">${feat.map(f=>{
    const img=isImageUrl(f.url);
    return `<div class="card feat">
      <div class="thumb">${img?`<img src="${esc(f.url)}" alt="${esc(f.title)}">`:`<span class="doc">PDF</span>`}</div>
      <div class="fbody"><div class="ftitle">${esc(f.title)}</div><div class="fmeta">${esc(f.author)} · ${timeAgo(f.ts)}</div>${f.note?`<div style="font-size:14px;color:var(--ink-soft)">${esc(f.note)}</div>`:""}
      <div class="flinks"><a href="${esc(f.url)}" target="_blank" rel="noopener">View</a><a href="${esc(f.url)}" download target="_blank" rel="noopener">Download</a></div>
      <button class="del" data-fdel="${f.id}">Delete</button></div></div>`;}).join("")}</div>`
    :`<div class="card empty"><div class="big">No newsletters or graphics yet</div>Paste a link to a PDF or image above — it'll appear here to view or download.</div>`;

  const kudHtml = kud.length?kud.map(k=>`<div class="kudos"><div class="khead"><span class="kstar">★</span> For <b>${esc(k.to)}</b></div><div class="ktext">"${esc(k.text)}"</div><div class="kmeta">— ${esc(k.from)} · ${timeAgo(k.ts)}</div></div>`).join("")
    :`<div class="card empty"><div class="big">No kudos yet</div>Be the first to recognize a teammate above.</div>`;

  panel().innerHTML=greet+upHtml+`
    <div class="card composer"><div class="eyebrow">— Newsletter / graphic —</div>
      <input type="text" id="fT" placeholder="Title (e.g. June Newsletter)">
      <div class="mt"><input type="text" id="fU" placeholder="Paste a link to the PDF or image…"></div>
      <div class="mt"><input type="text" id="fN" placeholder="A short note (optional)…"></div>
      <div class="mt" style="text-align:right"><button class="btn" id="fPost" ${me?'':'disabled'}>${me?'Post to home':'Pick your name'}</button></div>
    </div>
    ${featHtml}

    <div class="sectionhead" style="margin-top:30px"><h2 class="h-script">Recognition & Kudos</h2></div>
    <div class="card composer"><div class="eyebrow">— Give a shout-out —</div>
      <div class="row">
        <div class="col" style="min-width:160px"><label class="fld">For</label><select class="in" id="kWho"><option value="">— Teammate —</option>${EMPLOYEES.filter(ACCESS).map(e=>`<option value="${e.name}">${e.name}</option>`).join("")}</select></div>
        <div class="col" style="min-width:220px"><label class="fld">Kudos</label><input type="text" id="kMsg" placeholder="What did they do well?"></div>
        <div style="flex:0 0 auto"><button class="btn" id="kPost" ${me?'':'disabled'}>${me?'Send kudos':'Pick your name'}</button></div>
      </div>
    </div>
    ${kudHtml}

    <div class="sectionhead" style="margin-top:30px"><h2 class="h-script">Company News</h2></div>
    <div class="card composer"><div class="eyebrow">— Share with the team —</div>
      <input type="text" id="nT" placeholder="What's the news?">
      <div class="mt"><textarea id="nB" placeholder="Details (optional)…"></textarea></div>
      <div class="mt" style="text-align:right"><button class="btn" id="nPost" ${me?'':'disabled'}>${me?'Post update':'Pick your name'}</button></div>
    </div>
    <div class="card">${feed.length?feed.map(n=>`<div class="item"><div class="head"><h3>${esc(n.title)}</h3><button class="del" data-del="${n.id}">Delete</button></div><div class="meta">${esc(n.author)} · ${timeAgo(n.ts)}</div>${n.body?`<p>${esc(n.body)}</p>`:""}</div>`).join(""):`<div class="empty"><div class="big">No news yet</div>Post the first update to get the team in the loop.</div>`}</div>`;

  const tm=document.getElementById("toMine");if(tm)tm.onclick=()=>{activeView="mydash";render();};
  if(me){
    document.getElementById("fPost").onclick=async()=>{const t=document.getElementById("fT").value.trim(),u=document.getElementById("fU").value.trim();if(!t||!u)return;state.featured.push({id:uid(),title:t,url:u,note:document.getElementById("fN").value.trim(),author:me,ts:Date.now()});await saveFeatured();render();};
    document.getElementById("kPost").onclick=async()=>{const w=document.getElementById("kWho").value,m=document.getElementById("kMsg").value.trim();if(!w||!m)return;state.kudos.push({id:uid(),to:w,from:me,text:m,ts:Date.now()});await saveKudos();render();};
    document.getElementById("nPost").onclick=async()=>{const t=document.getElementById("nT").value.trim();if(!t)return;state.news.push({id:uid(),title:t,body:document.getElementById("nB").value.trim(),author:me,ts:Date.now()});await saveNews();render();};
  }
  panel().querySelectorAll("[data-fdel]").forEach(b=>b.onclick=async()=>{if(!confirm("Remove this post?"))return;state.featured=state.featured.filter(f=>f.id!==b.dataset.fdel);await saveFeatured();render();});
  panel().querySelectorAll(".item [data-del]").forEach(b=>b.onclick=async()=>{if(!confirm("Delete this update?"))return;state.news=state.news.filter(n=>n.id!==b.dataset.del);await saveNews();render();});
