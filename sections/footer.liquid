          "id": "subheading_size",
          "label": "Subheading size (desktop)",
          "min": 12,
          "max": 40,
          "step": 2,
          "unit": "px",
          "default": 18
        },
        {
          "type": "range",
          "id": "mobile_subheading_size",
          "label": "Subheading size (mobile)",
          "min": 12,
          "max": 32,
          "step": 2,
          "unit": "px",
          "default": 16
