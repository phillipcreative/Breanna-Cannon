{% comment %}
  Tabbed Feature Section
  - Each BLOCK represents one tab.
  - Clicking a tab updates the left content (title/description) and the right image.
{% endcomment %}

<section id="tabbed-feature-{{ section.id }}" class="tabbed-feature">
  <div class="tabbed-feature__inner page-width">
    <!-- LEFT: Tabs + Content -->
    <div class="tabbed-feature__left">
      {%- if section.settings.tabs_label != blank -%}
        <div class="tabbed-feature__tabs-label">{{ section.settings.tabs_label }}</div>
      {%- endif -%}

      <div class="tabbed-feature__tabs" role="tablist" aria-label="{{ section.settings.tabs_aria_label | escape }}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'tab_item' and block.settings.metaobject != blank -%}
            {%- assign metaobject_item = block.settings.metaobject -%}
            {%- assign is_active = forloop.first -%}
            <button
              id="tab-{{ block.id }}"
              class="tabbed-feature__tab{% if is_active %} is-active{% endif %}"
              role="tab"
              aria-selected="{{ is_active }}"
              aria-controls="panel-{{ block.id }}"
              tabindex="{% if is_active %}0{% else %}-1{% endif %}"
              data-tab-target="panel-{{ block.id }}"
            >
              <span class="tabbed-feature__tab-text">
                {%- if metaobject_item.tab_label != blank -%}
                  {{ metaobject_item.tab_label | escape }}
                {%- else -%}
                  Tab {{ forloop.index }}
                {%- endif -%}
              </span>
              <span class="tabbed-feature__tab-plus" aria-hidden="true">{% render 'plus-icon' %}</span>
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="tabbed-feature__content">
        {%- for block in section.blocks -%}
          {%- if block.type == 'tab_item' and block.settings.metaobject != blank -%}
            {%- assign metaobject_item = block.settings.metaobject -%}
            {%- assign is_active = forloop.first -%}
            <div
              id="panel-{{ block.id }}"
              class="tabbed-feature__panel"
              role="tabpanel"
              aria-labelledby="tab-{{ block.id }}"
              {% unless is_active %}hidden{% endunless %}
              {{ block.shopify_attributes }}
            >
              {%- if metaobject_item.eye_brow_title != blank -%}
                <div class="tabbed-feature__kicker">{{ metaobject_item.eye_brow_title }}</div>
              {%- elsif metaobject_item.eye_brow_title.value != blank -%}
                <div class="tabbed-feature__kicker">{{ metaobject_item.eye_brow_title.value }}</div>
              {%- endif -%}

              {%- if metaobject_item.title != blank -%}
                <h2 class="tabbed-feature__title">{{ metaobject_item.title }}</h2>
              {%- elsif metaobject_item.title.value != blank -%}
                <h2 class="tabbed-feature__title">{{ metaobject_item.title.value }}</h2>
              {%- endif -%}

              {%- if metaobject_item.description != blank -%}
                <div class="tabbed-feature__description rte">
                  {{ metaobject_item.description }}
                </div>
              {%- elsif metaobject_item.description.value != blank -%}
                <div class="tabbed-feature__description rte">
                  {{ metaobject_item.description.value }}
                </div>
              {%- endif -%}

              <div class="tab-tag-container {% if metaobject_item.tag_link_one_url == blank and metaobject_item.tag_link_two_url == blank and metaobject_item.tag_link_three_url == blank %}hidden{% endif %}">
                {%- if section.settings.tag_section_label != blank -%}
                  <div class="tabbed-feature__tag-section-label">{{ section.settings.tag_section_label }}</div>
                {%- endif -%}

                <div class="tabbed-feature__tags {% if metaobject_item.tag_link_three_url == blank %}no-grid{% endif %}">
                  {%- if metaobject_item.tag_link_one_url != blank -%}
                    {%- if metaobject_item.tag_link_one_url.url != blank -%}
                      <div class="tabbed-feature__tag">
                        <a href="{{ metaobject_item.tag_link_one_url.url }}">{% render 'plus-icon' %} {{ metaobject_item.tag_link_one_url.text }}</a>
                      </div>
                    {%- elsif metaobject_item.tag_link_one_url.value != blank and metaobject_item.tag_link_one_url.value.url != blank -%}
                      <div class="tabbed-feature__tag">
                        <a href="{{ metaobject_item.tag_link_one_url.value.url }}">{% render 'plus-icon' %} {{ metaobject_item.tag_link_one_url.value.text }}</a>
                      </div>
                    {%- endif -%}
                  {%- endif -%}
                  {%- if metaobject_item.tag_link_two_url != blank -%}
                    {%- if metaobject_item.tag_link_two_url.url != blank -%}
                      <div class="tabbed-feature__tag">
                        <a href="{{ metaobject_item.tag_link_two_url.url }}">{% render 'plus-icon' %} {{ metaobject_item.tag_link_two_url.text }}</a>
                      </div>
                    {%- elsif metaobject_item.tag_link_two_url.value != blank and metaobject_item.tag_link_two_url.value.url != blank -%}
                      <div class="tabbed-feature__tag">
                        <a href="{{ metaobject_item.tag_link_two_url.value.url }}">{% render 'plus-icon' %} {{ metaobject_item.tag_link_two_url.value.text }}</a>
                      </div>
                    {%- endif -%}
                  {%- endif -%}
                  {%- if metaobject_item.tag_link_three_url != blank -%}
                    {%- if metaobject_item.tag_link_three_url.url != blank -%}
                      <div class="tabbed-feature__tag">
                        <a href="{{ metaobject_item.tag_link_three_url.url }}">{% render 'plus-icon' %} {{ metaobject_item.tag_link_three_url.text }}</a>
                      </div>
                    {%- elsif metaobject_item.tag_link_three_url.value != blank and metaobject_item.tag_link_three_url.value.url != blank -%}
                      <div class="tabbed-feature__tag">
                        <a href="{{ metaobject_item.tag_link_three_url.value.url }}">{% render 'plus-icon' %} {{ metaobject_item.tag_link_three_url.value.text }}</a>
                      </div>
                    {%- endif -%}
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <!-- RIGHT: Images/Videos (switch per tab) -->
    <div class="tabbed-feature__right">
      {%- for block in section.blocks -%}
        {%- if block.type == 'tab_item' and block.settings.metaobject != blank -%}
          {%- assign metaobject_item = block.settings.metaobject -%}
          {%- assign is_active = forloop.first -%}
          {%- liquid
            assign has_video = false
            assign video_media = blank

            if metaobject_item.content_video != blank
              assign has_video = true
              if metaobject_item.content_video.value != blank
                assign video_media = metaobject_item.content_video.value
              else
                assign video_media = metaobject_item.content_video
              endif
            endif
          -%}
          <figure
            id="image-{{ block.id }}"
            class="tabbed-feature__image-wrap{% if has_video %} tabbed-feature__image-wrap--video{% endif %}"
            {% unless is_active %}hidden{% endunless %}
            {% if is_active %}aria-hidden="false"{% else %}aria-hidden="true"{% endif %}
          >
            {%- if has_video and video_media != blank -%}
              <div class="tabbed-feature__video-wrapper">
                {%- if is_active -%}
                  {{ video_media | video_tag: controls: true, autoplay: true, muted: true, playsinline: true, loop: true, class: 'tabbed-feature__video' }}
                {%- else -%}
                  {{ video_media | video_tag: controls: true, autoplay: false, muted: true, playsinline: true, loop: true, class: 'tabbed-feature__video' }}
                {%- endif -%}
              </div>
            {%- elsif metaobject_item.content_image != blank -%}
              {{ metaobject_item.content_image
                | image_url: width: 1400
                | image_tag:
                  class: 'tabbed-feature__image',
                  loading: 'lazy',
                  widths: '400,700,900,1200,1400',
                  alt: metaobject_item.title | escape
              }}
            {%- elsif metaobject_item.content_image.value != blank -%}
              {{ metaobject_item.content_image.value
                | image_url: width: 1400
                | image_tag:
                  class: 'tabbed-feature__image',
                  loading: 'lazy',
                  widths: '400,700,900,1200,1400',
                  alt: metaobject_item.title.value | escape
              }}
            {%- else -%}
              <div class="tabbed-feature__image--placeholder">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {%- endif -%}
          </figure>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <script>
    (function() {
      const root = document.getElementById('tabbed-feature-{{ section.id }}');
      if (!root) return;

      const tabs = root.querySelectorAll('.tabbed-feature__tab');
      const panels = root.querySelectorAll('.tabbed-feature__panel');
      const images = root.querySelectorAll('.tabbed-feature__image-wrap');

      function activate(targetId) {
        // Tabs
        tabs.forEach(btn => {
          const active = btn.dataset.tabTarget === targetId;
          btn.classList.toggle('is-active', active);
          btn.setAttribute('aria-selected', active ? 'true' : 'false');
          btn.tabIndex = active ? 0 : -1;
        });
        // Panels
        panels.forEach(panel => {
          panel.hidden = panel.id !== targetId;
        });
        // Images/Videos (use matching suffix)
        const suffix = targetId.replace('panel-', '');
        images.forEach(img => {
          const isActive = img.id === ('image-' + suffix);
          img.hidden = !isActive;
          img.setAttribute('aria-hidden', isActive ? 'false' : 'true');

          // Handle video playback
          const video = img.querySelector('.tabbed-feature__video');
          if (video) {
            if (isActive) {
              video.play().catch(err => {
                // Autoplay may be blocked, but that's okay
                console.log('Video autoplay prevented:', err);
              });
            } else {
              video.pause();
              video.currentTime = 0; // Reset to beginning
            }
          }
        });
      }

      tabs.forEach(btn => {
        btn.addEventListener('click', () => activate(btn.dataset.tabTarget));
        btn.addEventListener('keydown', (e) => {
          // Arrow key roving for accessibility
          if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
          const arr = Array.from(tabs);
          const idx = arr.indexOf(e.currentTarget);
          const nextIdx = e.key === 'ArrowRight'
            ? (idx + 1) % arr.length
            : (idx - 1 + arr.length) % arr.length;
          arr[nextIdx].focus();
          arr[nextIdx].click();
        });
      });

      // Auto-play video for initially active tab
      const activeImage = root.querySelector('.tabbed-feature__image-wrap:not([hidden])');
      if (activeImage) {
        const activeVideo = activeImage.querySelector('.tabbed-feature__video');
        if (activeVideo) {
          activeVideo.play().catch(err => {
            // Autoplay may be blocked, but that's okay
            console.log('Video autoplay prevented:', err);
          });
        }
      }
    })();
  </script>
</section>

{% schema %}
{
  "name": "Tabbed Feature",
  "settings": [
    { "type": "text", "id": "tabs_label", "label": "Tabs label (optional)", "default": "Topics" },
    { "type": "text", "id": "tabs_aria_label", "label": "Tabs ARIA label", "default": "Feature tabs" },
    { "type": "text", "id": "tag_section_label", "label": "Tag section label", "default": "shop similar styles" }
  ],
  "blocks": [
    {
      "type": "tab_item",
      "name": "Tab Item",
      "settings": [
        {
          "type": "metaobject",
          "id": "metaobject",
          "metaobject_type": "style_tab_content",
          "label": "Tab Content Metaobject",
          "info": "Select a metaobject containing: tab_label, eye_brow_title, title, description, content_video (overrides content_image), content_image, tag_link_one_url, tag_link_two_url, tag_link_three_url"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tabbed Feature"
    }
  ]
}
{% endschema %}
