{% doc %}
  @prompt
    Use this prompt in Shopify AI:
    
    Create a responsive horizontal category carousel similar to a premium fashion eCommerce collection navigation.
    
    Desktop Requirements
    
    Display all category buttons in a single horizontal carousel row.
    Include left and right navigation arrows on both sides of the carousel.
    Clicking arrows should smoothly scroll the categories horizontally.
    Categories should appear as clean pill-shaped buttons with thin borders.
    Buttons should have subtle hover effects.
    Keep spacing generous and modern.
    Center-align the section title above the carousel.
    Desktop should prioritize arrow navigation, while still allowing drag/scroll if available.
    
    Mobile Requirements
    
    Hide navigation arrows.
    Enable touch swipe left/right to browse categories.
    Show only a few category pills on screen at once.
    Maintain smooth momentum scrolling.
    Prevent buttons from wrapping to multiple lines.
    Keep the experience fast, simple, and thumb-friendly.
    
    Styling
    
    Minimal luxury fashion aesthetic.
    White or light gray background.
    Black text.
    Thin black borders on category pills.
    Rounded pill buttons.
    Clean typography with generous whitespace.
    Subtle hover and active states.
    
    Functionality
    
    Fully responsive.
    Works in Shopify without external libraries.
    Uses semantic HTML, CSS, and vanilla JavaScript.
    Smooth horizontal scrolling animation.
    Accessible arrow controls and keyboard navigation.
    
    Example categories:
    
    Tops & Blouses
    Shackets & Jackets
    Bottoms
    Dresses & Jumpsuits
    Bags
    Sneakers
    Accessories
    New Arrivals
    
    Build it as a reusable Shopify section with settings so I can easily add, remove, and reorder categories from the Shopify theme editor.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-category-carousel-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-category-carousel__title-{{ ai_gen_id }} {
    text-align: center;
    margin: 0 0 {{ block.settings.title_spacing }}px;
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    font-weight: 600;
  }

  .ai-category-carousel__wrapper-{{ ai_gen_id }} {
    position: relative;
    max-width: 100%;
    margin: 0 auto;
    padding: 0 {{ block.settings.horizontal_padding }}px;
  }

  .ai-category-carousel__container-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .ai-category-carousel__scroll-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.pill_spacing }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 8px 0;
  }

  .ai-category-carousel__scroll-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-category-carousel__pill-{{ ai_gen_id }} {
    flex-shrink: 0;
    display: inline-block;
    padding: {{ block.settings.pill_padding_vertical }}px {{ block.settings.pill_padding_horizontal }}px;
    background-color: {{ block.settings.pill_background }};
    color: {{ block.settings.text_color }};
    border: {{ block.settings.pill_border_width }}px solid {{ block.settings.pill_border_color }};
    border-radius: {{ block.settings.pill_border_radius }}px;
    text-decoration: none;
    font-size: {{ block.settings.pill_font_size }}px;
    white-space: nowrap;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .ai-category-carousel__pill-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.pill_hover_background }};
    color: {{ block.settings.pill_hover_text }};
    border-color: {{ block.settings.pill_hover_border }};
    transform: translateY(-2px);
  }

  .ai-category-carousel__arrow-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.arrow_size }}px;
    height: {{ block.settings.arrow_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.arrow_background }};
    border: {{ block.settings.arrow_border_width }}px solid {{ block.settings.arrow_border_color }};
    border-radius: 50%;
    cursor: pointer;
    transition: all 0.2s ease;
    padding: 0;
  }

  .ai-category-carousel__arrow-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.arrow_hover_background }};
    border-color: {{ block.settings.arrow_hover_border }};
    transform: scale(1.1);
  }

  .ai-category-carousel__arrow-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-category-carousel__arrow-{{ ai_gen_id }}:disabled:hover {
    transform: none;
  }

  .ai-category-carousel__arrow-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    stroke: {{ block.settings.arrow_color }};
    stroke-width: 2;
  }

  @media screen and (max-width: 749px) {
    .ai-category-carousel__arrow-{{ ai_gen_id }} {
      display: none;
    }

    .ai-category-carousel__wrapper-{{ ai_gen_id }} {
      padding: 0 {{ block.settings.mobile_horizontal_padding }}px;
    }

    .ai-category-carousel__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-category-carousel__pill-{{ ai_gen_id }} {
      font-size: {{ block.settings.pill_font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<category-carousel-{{ ai_gen_id }} class="ai-category-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.title != blank %}
    <h2 class="ai-category-carousel__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
  {% endif %}

  <div class="ai-category-carousel__wrapper-{{ ai_gen_id }}">
    <div class="ai-category-carousel__container-{{ ai_gen_id }}">
      <button
        class="ai-category-carousel__arrow-{{ ai_gen_id }} ai-category-carousel__arrow-left-{{ ai_gen_id }}"
        aria-label="Scroll left"
        data-direction="left"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="ai-category-carousel__scroll-{{ ai_gen_id }}">
       {% for i in (1..8) %}
  {% liquid
    assign cat_label_key = 'cat_' | append: i | append: '_label'
    assign cat_url_key = 'cat_' | append: i | append: '_url'
    assign category_text_key = 'category_' | append: i | append: '_text'
    assign category_url_key = 'category_' | append: i | append: '_url'

    assign meta_label = collection.metafields.category_nav[cat_label_key].value
    assign meta_url = collection.metafields.category_nav[cat_url_key].value
    assign fallback_text = block.settings[category_text_key]
    assign fallback_url = block.settings[category_url_key]

    if meta_label != blank
      assign pill_text = meta_label
    else
      assign pill_text = fallback_text
    endif

    if meta_url != blank
      assign pill_url = meta_url
    else
      assign pill_url = fallback_url
    endif
  %}

  {% if pill_text != blank %}
    <a
      href="{{ pill_url }}"
      class="ai-category-carousel__pill-{{ ai_gen_id }}"
    >
      {{ pill_text }}
    </a>
  {% endif %}
{% endfor %}

      </div>

      <button
        class="ai-category-carousel__arrow-{{ ai_gen_id }} ai-category-carousel__arrow-right-{{ ai_gen_id }}"
        aria-label="Scroll right"
        data-direction="right"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </div>
</category-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class CategoryCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.scrollContainer = null;
        this.leftArrow = null;
        this.rightArrow = null;
        this.scrollAmount = 300;
      }

      connectedCallback() {
        this.scrollContainer = this.querySelector('.ai-category-carousel__scroll-{{ ai_gen_id }}');
        this.leftArrow = this.querySelector('.ai-category-carousel__arrow-left-{{ ai_gen_id }}');
        this.rightArrow = this.querySelector('.ai-category-carousel__arrow-right-{{ ai_gen_id }}');

        if (!this.scrollContainer || !this.leftArrow || !this.rightArrow) return;

        this.setupEventListeners();
        this.updateArrowStates();
      }

      setupEventListeners() {
        this.leftArrow.addEventListener('click', () => this.scroll('left'));
        this.rightArrow.addEventListener('click', () => this.scroll('right'));

        this.scrollContainer.addEventListener('scroll', () => this.updateArrowStates());

        window.addEventListener('resize', () => this.updateArrowStates());

        this.scrollContainer.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowLeft') {
            e.preventDefault();
            this.scroll('left');
          } else if (e.key === 'ArrowRight') {
            e.preventDefault();
            this.scroll('right');
          }
        });
      }

      scroll(direction) {
        const scrollDistance = direction === 'left' ? -this.scrollAmount : this.scrollAmount;
        this.scrollContainer.scrollBy({
          left: scrollDistance,
          behavior: 'smooth'
        });
      }

      updateArrowStates() {
        const isAtStart = this.scrollContainer.scrollLeft <= 0;
        const isAtEnd = this.scrollContainer.scrollLeft + this.scrollContainer.clientWidth >= this.scrollContainer.scrollWidth - 1;

        this.leftArrow.disabled = isAtStart;
        this.rightArrow.disabled = isAtEnd;
      }
    }

    customElements.define('category-carousel-{{ ai_gen_id }}', CategoryCarousel{{ ai_gen_id }});
  })();
</script>

