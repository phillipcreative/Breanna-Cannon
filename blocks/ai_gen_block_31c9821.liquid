{% doc %}
  @prompt
    create a full width search bar that i can put as a section in my homepage. this needs a headline, sub headline, and a search bar. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-search-hero-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    text-align: center;
  }

  .ai-search-hero-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-search-hero-heading-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
  }

  .ai-search-hero-subheading-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.subheading_spacing }}px;
    color: {{ block.settings.subheading_color }};
    font-size: {{ block.settings.subheading_size }}px;
    line-height: 1.4;
  }

  .ai-search-hero-form-{{ ai_gen_id }} {
    position: relative;
    max-width: {{ block.settings.search_bar_width }}px;
    margin: 0 auto;
  }

  .ai-search-hero-input-wrapper-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    align-items: center;
  }

  .ai-search-hero-input-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.input_padding }}px {{ block.settings.input_padding | plus: 50 }}px {{ block.settings.input_padding }}px {{ block.settings.input_padding }}px;
    font-size: {{ block.settings.input_font_size }}px;
    border: {{ block.settings.input_border_width }}px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    background-color: {{ block.settings.input_background_color }};
    color: {{ block.settings.input_text_color }};
    outline: none;
    transition: border-color 0.3s ease;
  }

  .ai-search-hero-input-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.input_placeholder_color }};
  }

  .ai-search-hero-input-{{ ai_gen_id }}:focus {
    border-color: {{ block.settings.input_focus_border_color }};
  }

  .ai-search-hero-button-{{ ai_gen_id }} {
    position: absolute;
    right: {{ block.settings.input_padding | divided_by: 2 }}px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    padding: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.search_icon_color }};
    transition: color 0.3s ease;
  }

  .ai-search-hero-button-{{ ai_gen_id }}:hover {
    color: {{ block.settings.search_icon_hover_color }};
  }

  .ai-search-hero-button-{{ ai_gen_id }} svg {
    width: {{ block.settings.search_icon_size }}px;
    height: {{ block.settings.search_icon_size }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-search-hero-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.6 }}px 16px {{ block.settings.padding_bottom | times: 0.6 }}px;
    }

    .ai-search-hero-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
      margin-bottom: {{ block.settings.heading_spacing | times: 0.7 }}px;
    }

    .ai-search-hero-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.8 }}px;
      margin-bottom: {{ block.settings.subheading_spacing | times: 0.8 }}px;
    }

    .ai-search-hero-input-{{ ai_gen_id }} {
      font-size: {{ block.settings.input_font_size | times: 0.9 }}px;
      padding: {{ block.settings.input_padding | times: 0.8 }}px {{ block.settings.input_padding | times: 0.8 | plus: 50 }}px {{ block.settings.input_padding | times: 0.8 }}px {{ block.settings.input_padding | times: 0.8 }}px;
    }
  }
{% endstyle %}

<search-hero-{{ ai_gen_id }} class="ai-search-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-search-hero-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-search-hero-heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h2>
    {% endif %}

    {% if block.settings.subheading != blank %}
      <div class="ai-search-hero-subheading-{{ ai_gen_id }}">
        {{ block.settings.subheading }}
      </div>
    {% endif %}

    <form
      action="{{ routes.search_url }}"
      method="get"
      role="search"
      class="ai-search-hero-form-{{ ai_gen_id }}"
    >
      <div class="ai-search-hero-input-wrapper-{{ ai_gen_id }}">
        <input
          type="search"
          name="q"
          class="ai-search-hero-input-{{ ai_gen_id }}"
          placeholder="{{ block.settings.placeholder }}"
          aria-label="Search"
          autocomplete="off"
        >
        <button
          type="submit"
          class="ai-search-hero-button-{{ ai_gen_id }}"
          aria-label="Search"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.35-4.35"></path>
          </svg>
        </button>
      </div>
    </form>
  </div>
</search-hero-{{ ai_gen_id }}>

<script>
  (function() {
    class SearchHero{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.form = this.querySelector('.ai-search-hero-form-{{ ai_gen_id }}');
        this.input = this.querySelector('.ai-search-hero-input-{{ ai_gen_id }}');
        
        if (this.form && this.input) {
          this.form.addEventListener('submit', this.handleSubmit.bind(this));
        }
      }

      handleSubmit(event) {
        if (!this.input.value.trim()) {
          event.preventDefault();
          this.input.focus();
        }
      }
    }

    customElements.define('search-hero-{{ ai_gen_id }}', SearchHero{{ ai_gen_id }});
  })();
</script>

