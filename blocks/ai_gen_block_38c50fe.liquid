{% doc %}
  @prompt
    I want a link to the SIZE CHART page, change the icon next to the word size chart so it's a measuring tape or something that relates to size measurements , change the icon next to the word Size Chart so it's a ruler instead of a cube
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-size-chart-link-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-size-chart-link__wrapper-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size }}px;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    transition: all 0.3s ease;
    {% if block.settings.show_border %}
      border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    {% endif %}
  }

  .ai-size-chart-link__wrapper-{{ ai_gen_id }}:hover {
    color: {{ block.settings.hover_text_color }};
    background-color: {{ block.settings.hover_background_color }};
    {% if block.settings.show_border %}
      border-color: {{ block.settings.hover_border_color }};
    {% endif %}
  }

  .ai-size-chart-link__icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
  }

  .ai-size-chart-link__icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: currentColor;
    fill: none;
  }

  .ai-size-chart-link__text-{{ ai_gen_id }} {
    font-weight: {{ block.settings.font_weight }};
  }
{% endstyle %}

<div class="ai-size-chart-link-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <a href="{{ block.settings.size_chart_page.url }}" class="ai-size-chart-link__wrapper-{{ ai_gen_id }}">
    {% if block.settings.show_icon %}
      <span class="ai-size-chart-link__icon-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.41 2.41 0 0 1 0-3.4l2.6-2.6a2.41 2.41 0 0 1 3.4 0Z"></path>
          <path d="m14.5 12.5 2-2"></path>
          <path d="m11.5 9.5 2-2"></path>
          <path d="m8.5 6.5 2-2"></path>
          <path d="m17.5 15.5 2-2"></path>
        </svg>
      </span>
    {% endif %}
    <span class="ai-size-chart-link__text-{{ ai_gen_id }}">{{ block.settings.link_text }}</span>
  </a>
</div>

{% schema %}
{
  "name": "Size chart link",
  "settings": [
    {
      "type": "header",
      "content": "Link"
    },
    {
      "type": "page",
      "id": "size_chart_page",
      "label": "Size chart page"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "default": "Size Chart"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show icon",
      "default": true
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "500"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical padding",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal padding",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "hover_text_color",
      "label": "Hover text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "hover_background_color",
      "label": "Hover background color",
      "default": "#f4f4f4"
    },
    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show border",
      "default": true
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 1,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#e0e0e0"
    },
    {
      "type": "color",
      "id": "hover_border_color",
      "label": "Hover border color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Size chart link"
    }
  ]
}
{% endschema %}
