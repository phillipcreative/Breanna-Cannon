<script>
  (function() {
    class PillNavigation{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.dropdowns = this.querySelectorAll('[data-dropdown]');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.dropdowns.forEach((dropdown) => {
          const toggle = dropdown.querySelector('.ai-pill-nav-dropdown-toggle-{{ ai_gen_id }}');
          
          toggle.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            
            const isActive = dropdown.classList.contains('active');
            
            this.dropdowns.forEach((d) => {
              d.classList.remove('active');
              const t = d.querySelector('.ai-pill-nav-dropdown-toggle-{{ ai_gen_id }}');
              if (t) t.setAttribute('aria-expanded', 'false');
            });
            
            if (!isActive) {
              dropdown.classList.add('active');
              toggle.setAttribute('aria-expanded', 'true');
            }
          });
        });

        document.addEventListener('click', (e) => {
          if (!e.target.closest('.ai-pill-nav-item-{{ ai_gen_id }}')) {
            this.dropdowns.forEach((dropdown) => {
              dropdown.classList.remove('active');
              const toggle = dropdown.querySelector('.ai-pill-nav-dropdown-toggle-{{ ai_gen_id }}');
              if (toggle) toggle.setAttribute('aria-expanded', 'false');
            });
          }
        });
      }
    }

    customElements.define('pill-navigation-{{ ai_gen_id }}', PillNavigation{{ ai_gen_id }});
  })();
</script>

