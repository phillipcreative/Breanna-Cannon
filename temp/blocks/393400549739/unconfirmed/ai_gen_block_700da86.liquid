{% doc %}
  @prompt
    Generate a Text section that gives me the ability to control the width and height of the section, as well as the padding above or below the section. and the background color behind the text. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-text-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
  }

  .ai-text-section__container-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
  }

  .ai-text-section__content-{{ ai_gen_id }} {
    min-height: {{ block.settings.min_height }}px;
    display: flex;
    flex-direction: column;
    justify-content: {{ block.settings.vertical_alignment }};
    color: {{ block.settings.text_color }};
  }

  .ai-text-section__content-{{ ai_gen_id }} h1,
  .ai-text-section__content-{{ ai_gen_id }} h2,
  .ai-text-section__content-{{ ai_gen_id }} h3,
  .ai-text-section__content-{{ ai_gen_id }} h4,
  .ai-text-section__content-{{ ai_gen_id }} h5,
  .ai-text-section__content-{{ ai_gen_id }} h6 {
    margin-top: 0;
    margin-bottom: 16px;
  }

  .ai-text-section__content-{{ ai_gen_id }} p {
    margin-top: 0;
    margin-bottom: 16px;
  }

  .ai-text-section__content-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-text-section__content-{{ ai_gen_id }} * {
    text-align: {{ block.settings.text_alignment }};
  }

  @media screen and (max-width: 749px) {
    .ai-text-section__container-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-text-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-text-section__container-{{ ai_gen_id }}">
    <div class="ai-text-section__content-{{ ai_gen_id }}">
      {% if block.settings.text != blank %}
        {{ block.settings.text }}
      {% else %}
        <p>Add your text content here</p>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Text section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Add your text content here. You can format it with headings, paragraphs, and more.</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 0,
      "max": 800,
      "step": 50,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 50
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Text section"
    }
  ],
  "tag": null
}
{% endschema %}
