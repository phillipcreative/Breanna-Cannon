{% doc %}
  @prompt
    make a cute instagram feed looking grid of photos ugc reviews from customers. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-ugc-grid-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
  }

  .ai-ugc-grid__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-ugc-grid__item-{{ ai_gen_id }} {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    background-color: {{ block.settings.placeholder_bg_color }};
    cursor: pointer;
    transition: transform 0.3s ease;
  }

  .ai-ugc-grid__item-{{ ai_gen_id }}:hover {
    transform: scale(1.02);
  }

  .ai-ugc-grid__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-ugc-grid__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.placeholder_bg_color }};
  }

  .ai-ugc-grid__placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  .ai-ugc-grid__overlay-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent);
    padding: 16px;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ai-ugc-grid__item-{{ ai_gen_id }}:hover .ai-ugc-grid__overlay-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-ugc-grid__customer-name-{{ ai_gen_id }} {
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
    margin: 0 0 4px 0;
  }

  .ai-ugc-grid__stars-{{ ai_gen_id }} {
    display: flex;
    gap: 2px;
  }

  .ai-ugc-grid__star-{{ ai_gen_id }} {
    color: {{ block.settings.star_color }};
    font-size: 14px;
  }

  .ai-ugc-grid__modal-{{ ai_gen_id }} {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.9);
    z-index: 9999;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .ai-ugc-grid__modal-{{ ai_gen_id }}.active {
    display: flex;
  }

  .ai-ugc-grid__modal-content-{{ ai_gen_id }} {
    background-color: {{ block.settings.modal_bg_color }};
    border-radius: {{ block.settings.modal_border_radius }}px;
    max-width: 600px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    position: relative;
  }

  .ai-ugc-grid__modal-image-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: {{ block.settings.modal_border_radius }}px {{ block.settings.modal_border_radius }}px 0 0;
  }

  .ai-ugc-grid__modal-body-{{ ai_gen_id }} {
    padding: 24px;
  }

  .ai-ugc-grid__modal-header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 16px;
  }

  .ai-ugc-grid__modal-customer-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-ugc-grid__modal-name-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 600;
    color: {{ block.settings.modal_text_color }};
    margin: 0 0 8px 0;
  }

  .ai-ugc-grid__modal-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
  }

  .ai-ugc-grid__modal-star-{{ ai_gen_id }} {
    color: {{ block.settings.star_color }};
    font-size: 16px;
  }

  .ai-ugc-grid__modal-close-{{ ai_gen_id }} {
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    color: {{ block.settings.modal_text_color }};
    opacity: 0.7;
  }

  .ai-ugc-grid__modal-close-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-ugc-grid__modal-review-{{ ai_gen_id }} {
    color: {{ block.settings.modal_text_color }};
    font-size: 16px;
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-ugc-grid__container-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.grid_gap | times: 0.75 }}px;
    }

    .ai-ugc-grid__modal-content-{{ ai_gen_id }} {
      max-width: 100%;
    }

    .ai-ugc-grid__modal-body-{{ ai_gen_id }} {
      padding: 16px;
    }
  }
{% endstyle %}

<ugc-review-grid-{{ ai_gen_id }} class="ai-ugc-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-ugc-grid__container-{{ ai_gen_id }}">
    {% for i in (1..9) %}
      {% liquid
        assign image_key = 'review_' | append: i | append: '_image'
        assign name_key = 'review_' | append: i | append: '_name'
        assign rating_key = 'review_' | append: i | append: '_rating'
        assign text_key = 'review_' | append: i | append: '_text'

        assign review_image = block.settings[image_key]
        assign review_name = block.settings[name_key]
        assign review_rating = block.settings[rating_key]
        assign review_text = block.settings[text_key]
      %}

      <div class="ai-ugc-grid__item-{{ ai_gen_id }}" data-review-index="{{ i }}">
        {% if review_image %}
          <img
            src="{{ review_image | image_url: width: 600 }}"
            alt="{{ review_name | escape }}"
            loading="lazy"
            width="600"
            height="600"
            class="ai-ugc-grid__image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-ugc-grid__placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}

        {% if review_name != blank or review_rating > 0 %}
          <div class="ai-ugc-grid__overlay-{{ ai_gen_id }}">
            {% if review_name != blank %}
              <p class="ai-ugc-grid__customer-name-{{ ai_gen_id }}">{{ review_name }}</p>
            {% endif %}
            {% if review_rating > 0 %}
              <div class="ai-ugc-grid__stars-{{ ai_gen_id }}">
                {% for star in (1..5) %}
                  <span class="ai-ugc-grid__star-{{ ai_gen_id }}">
                    {% if star <= review_rating %}★{% else %}☆{% endif %}
                  </span>
                {% endfor %}
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>

  <div class="ai-ugc-grid__modal-{{ ai_gen_id }}" data-modal>
    <div class="ai-ugc-grid__modal-content-{{ ai_gen_id }}">
      <img
        src=""
        alt=""
        class="ai-ugc-grid__modal-image-{{ ai_gen_id }}"
        data-modal-image
      >
      <div class="ai-ugc-grid__modal-body-{{ ai_gen_id }}">
        <div class="ai-ugc-grid__modal-header-{{ ai_gen_id }}">
          <div class="ai-ugc-grid__modal-customer-{{ ai_gen_id }}">
            <h3 class="ai-ugc-grid__modal-name-{{ ai_gen_id }}" data-modal-name></h3>
            <div class="ai-ugc-grid__modal-stars-{{ ai_gen_id }}" data-modal-stars></div>
          </div>
          <button class="ai-ugc-grid__modal-close-{{ ai_gen_id }}" aria-label="Close">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
        <p class="ai-ugc-grid__modal-review-{{ ai_gen_id }}" data-modal-review></p>
      </div>
    </div>
  </div>
</ugc-review-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class UgcReviewGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.reviews = [
          {% for i in (1..9) %}
            {% liquid
              assign image_key = 'review_' | append: i | append: '_image'
              assign name_key = 'review_' | append: i | append: '_name'
              assign rating_key = 'review_' | append: i | append: '_rating'
              assign text_key = 'review_' | append: i | append: '_text'

              assign review_image = block.settings[image_key]
              assign review_name = block.settings[name_key]
              assign review_rating = block.settings[rating_key]
              assign review_text = block.settings[text_key]
            %}
            {
              image: {{ review_image | image_url: width: 1200 | json }},
              name: {{ review_name | json }},
              rating: {{ review_rating }},
              text: {{ review_text | json }}
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ];
      }

      connectedCallback() {
        this.items = this.querySelectorAll('.ai-ugc-grid__item-{{ ai_gen_id }}');
        this.modal = this.querySelector('[data-modal]');
        this.modalImage = this.querySelector('[data-modal-image]');
        this.modalName = this.querySelector('[data-modal-name]');
        this.modalStars = this.querySelector('[data-modal-stars]');
        this.modalReview = this.querySelector('[data-modal-review]');
        this.closeButton = this.querySelector('.ai-ugc-grid__modal-close-{{ ai_gen_id }}');

        this.setupEventListeners();
      }

      setupEventListeners() {
        this.items.forEach((item) => {
          item.addEventListener('click', () => {
            const index = parseInt(item.dataset.reviewIndex) - 1;
            this.openModal(index);
          });
        });

        this.closeButton.addEventListener('click', () => {
          this.closeModal();
        });

        this.modal.addEventListener('click', (e) => {
          if (e.target === this.modal) {
            this.closeModal();
          }
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && this.modal.classList.contains('active')) {
            this.closeModal();
          }
        });
      }

      openModal(index) {
        const review = this.reviews[index];
        
        if (review.image) {
          this.modalImage.src = review.image;
          this.modalImage.alt = review.name || '';
        }

        this.modalName.textContent = review.name || '';
        
        this.modalStars.innerHTML = '';
        for (let i = 1; i <= 5; i++) {
          const star = document.createElement('span');
          star.className = 'ai-ugc-grid__modal-star-{{ ai_gen_id }}';
          star.textContent = i <= review.rating ? '★' : '☆';
          this.modalStars.appendChild(star);
        }

        this.modalReview.textContent = review.text || '';

        this.modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      closeModal() {
        this.modal.classList.remove('active');
        document.body.style.overflow = '';
      }
    }

    customElements.define('ugc-review-grid-{{ ai_gen_id }}', UgcReviewGrid{{ ai_gen_id }});
  })();
</script>

