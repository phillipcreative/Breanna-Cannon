      </a>
    {% endif %}

    {% if block.settings.link_4_text != blank %}
      <a
        href="{{ block.settings.link_4_url }}"
        class="ai-pill-nav-item-{{ ai_gen_id }} {% if block.settings.link_4_active %}active{% endif %}"
      >
        {{ block.settings.link_4_text }}
      </a>
    {% endif %}

    {% if block.settings.link_5_text != blank %}
      <a
        href="{{ block.settings.link_5_url }}"
        class="ai-pill-nav-item-{{ ai_gen_id }} {% if block.settings.link_5_active %}active{% endif %}"
      >
        {{ block.settings.link_5_text }}
      </a>
    {% endif %}

    {% if block.settings.link_6_text != blank %}
      <a
        href="{{ block.settings.link_6_url }}"
        class="ai-pill-nav-item-{{ ai_gen_id }} {% if block.settings.link_6_active %}active{% endif %}"
      >
        {{ block.settings.link_6_text }}
      </a>
    {% endif %}

    {% if block.settings.link_7_text != blank %}
      <a
        href="{{ block.settings.link_7_url }}"
        class="ai-pill-nav-item-{{ ai_gen_id }} {% if block.settings.link_7_active %}active{% endif %}"
      >
        {{ block.settings.link_7_text }}
      </a>
    {% endif %}

    {% if block.settings.link_8_text != blank %}
      <a
        href="{{ block.settings.link_8_url }}"
        class="ai-pill-nav-item-{{ ai_gen_id }} {% if block.settings.link_8_active %}active{% endif %}"
      >
        {{ block.settings.link_8_text }}
      </a>
    {% endif %}
  </div>
</nav>

