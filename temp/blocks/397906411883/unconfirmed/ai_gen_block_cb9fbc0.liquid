{% doc %}
  @prompt
    A magazine-style editorial layout, this is supposed to function like a horozontal menue - like this pill box nav from https://briannacannon.com/collections/bama  // redesign this 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-pill-nav-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.vertical_padding }}px {{ block.settings.horizontal_padding }}px;
  }

  .ai-pill-nav-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: {{ block.settings.alignment }};
    gap: {{ block.settings.pill_gap }}px;
    flex-wrap: wrap;
  }

  .ai-pill-nav-item-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.pill_padding_vertical }}px {{ block.settings.pill_padding_horizontal }}px;
    background-color: {{ block.settings.pill_bg_color }};
    color: {{ block.settings.pill_text_color }};
    text-decoration: none;
    font-size: {{ block.settings.pill_text_size }}px;
    border: {{ block.settings.pill_border_width }}px solid {{ block.settings.pill_border_color }};
    border-radius: {{ block.settings.pill_border_radius }}px;
    transition: all 0.3s ease;
    white-space: nowrap;
    text-transform: {{ block.settings.text_transform }};
    letter-spacing: {{ block.settings.letter_spacing }}px;
    font-weight: {{ block.settings.font_weight }};
  }

  .ai-pill-nav-item-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.pill_hover_bg_color }};
    color: {{ block.settings.pill_hover_text_color }};
    border-color: {{ block.settings.pill_hover_border_color }};
    transform: translateY(-2px);
  }

  .ai-pill-nav-item-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.pill_active_bg_color }};
    color: {{ block.settings.pill_active_text_color }};
    border-color: {{ block.settings.pill_active_border_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-pill-nav-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_vertical_padding }}px {{ block.settings.mobile_horizontal_padding }}px;
    }

    .ai-pill-nav-wrapper-{{ ai_gen_id }} {
      gap: {{ block.settings.mobile_pill_gap }}px;
      {% if block.settings.mobile_scroll %}
        flex-wrap: nowrap;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
      {% endif %}
    }

    .ai-pill-nav-wrapper-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }

    .ai-pill-nav-item-{{ ai_gen_id }} {
      font-size: {{ block.settings.pill_text_size | times: 0.9 }}px;
      padding: {{ block.settings.pill_padding_vertical | times: 0.9 }}px {{ block.settings.pill_padding_horizontal | times: 0.9 }}px;
    }
  }
{% endstyle %}

<nav class="ai-pill-nav-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-pill-nav-wrapper-{{ ai_gen_id }}">
    {% if block.settings.link_1_text != blank %}
      <a
        href="{{ block.settings.link_1_url }}"
        class="ai-pill-nav-item-{{ ai_gen_id }} {% if block.settings.link_1_active %}active{% endif %}"
      >
        {{ block.settings.link_1_text }}
      </a>
    {% endif %}

    {% if block.settings.link_2_text != blank %}
      <a
        href="{{ block.settings.link_2_url }}"
        class="ai-pill-nav-item-{{ ai_gen_id }} {% if block.settings.link_2_active %}active{% endif %}"
      >
        {{ block.settings.link_2_text }}
      </a>
    {% endif %}

    {% if block.settings.link_3_text != blank %}
      <a
        href="{{ block.settings.link_3_url }}"
