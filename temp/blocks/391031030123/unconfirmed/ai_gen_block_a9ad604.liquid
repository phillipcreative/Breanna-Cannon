{% doc %}
  @prompt
    a clean instagram feed that pulls imapges from https://www.instagram.com/briannacannonofficial/
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-instagram-feed-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-instagram-feed__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.grid_gap }}px;
  }

  .ai-instagram-feed__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 10px;
  }

  .ai-instagram-feed__handle-{{ ai_gen_id }} {
    font-size: {{ block.settings.handle_size }}px;
    color: {{ block.settings.handle_color }};
    text-decoration: none;
    display: inline-block;
  }

  .ai-instagram-feed__handle-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-instagram-feed__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-instagram-feed__item-{{ ai_gen_id }} {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background-color: {{ block.settings.placeholder_bg }};
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-instagram-feed__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .ai-instagram-feed__item-{{ ai_gen_id }}:hover .ai-instagram-feed__image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-instagram-feed__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.placeholder_bg }};
  }

  .ai-instagram-feed__placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  .ai-instagram-feed__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, {{ block.settings.overlay_opacity }});
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ai-instagram-feed__item-{{ ai_gen_id }}:hover .ai-instagram-feed__overlay-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-instagram-feed__icon-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    color: #ffffff;
  }

  @media screen and (max-width: 749px) {
    .ai-instagram-feed__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-instagram-feed__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }
  }
{% endstyle %}

<instagram-feed-{{ ai_gen_id }}
  class="ai-instagram-feed-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.show_header %}
    <div class="ai-instagram-feed__header-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-instagram-feed__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}
      {% if block.settings.instagram_handle != blank %}
        <a
          href="https://www.instagram.com/{{ block.settings.instagram_handle }}/"
          target="_blank"
          rel="noopener noreferrer"
          class="ai-instagram-feed__handle-{{ ai_gen_id }}"
        >
          @{{ block.settings.instagram_handle }}
        </a>
      {% endif %}
    </div>
  {% endif %}

  <div class="ai-instagram-feed__grid-{{ ai_gen_id }}">
    {% for i in (1..12) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign image = block.settings[image_key]
        assign link_key = 'link_' | append: i
        assign link = block.settings[link_key]
      %}

      {% if i <= block.settings.images_to_show %}
        <div class="ai-instagram-feed__item-{{ ai_gen_id }}">
          {% if link != blank %}
            <a href="{{ link }}" target="_blank" rel="noopener noreferrer">
          {% endif %}

          {% if image %}
            <img
              src="{{ image | image_url: width: 600 }}"
              alt="{{ image.alt | escape }}"
              loading="lazy"
              width="600"
              height="600"
              class="ai-instagram-feed__image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-instagram-feed__placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}

          {% if block.settings.show_overlay %}
            <div class="ai-instagram-feed__overlay-{{ ai_gen_id }}">
              <svg
                class="ai-instagram-feed__icon-{{ ai_gen_id }}"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
            </div>
          {% endif %}

          {% if link != blank %}
            </a>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</instagram-feed-{{ ai_gen_id }}>

<script>
  (function() {
    class InstagramFeed{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('instagram-feed-{{ ai_gen_id }}', InstagramFeed{{ ai_gen_id }});
  })();
</script>

