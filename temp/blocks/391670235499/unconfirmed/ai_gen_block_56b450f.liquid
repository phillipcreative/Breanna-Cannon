{% doc %}
  @prompt
    make me a landing page for the BC STYLE CLUB. this landing page should invite people to come in and get styled by one of our stylists, or by our founder, and creative director Brianna Cannon herself. Include a section that is a "how it works" section. 1,2,3 (pick a date, pick a stylist, shop & Get Styled). 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-bc-style-club-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-bc-hero-{{ ai_gen_id }} {
    position: relative;
    min-height: {{ block.settings.hero_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 60px 20px;
    background-color: {{ block.settings.hero_bg_color }};
    overflow: hidden;
  }

  .ai-bc-hero-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .ai-bc-hero-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.hero_overlay_color }};
    opacity: {{ block.settings.hero_overlay_opacity | divided_by: 100.0 }};
    z-index: 2;
  }

  .ai-bc-hero-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 3;
    max-width: 800px;
    color: {{ block.settings.hero_text_color }};
  }

  .ai-bc-hero-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.hero_title_size }}px;
    margin: 0 0 20px;
    color: {{ block.settings.hero_text_color }};
    line-height: 1.2;
  }

  .ai-bc-hero-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.hero_subtitle_size }}px;
    margin: 0 0 30px;
    color: {{ block.settings.hero_text_color }};
    line-height: 1.5;
  }

  .ai-bc-hero-cta-{{ ai_gen_id }} {
    display: inline-block;
    padding: 16px 40px;
    background-color: {{ block.settings.cta_bg_color }};
    color: {{ block.settings.cta_text_color }};
    text-decoration: none;
    font-size: {{ block.settings.cta_font_size }}px;
    border-radius: {{ block.settings.cta_border_radius }}px;
    transition: all 0.3s ease;
  }

  .ai-bc-hero-cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.cta_hover_bg_color }};
    color: {{ block.settings.cta_hover_text_color }};
    transform: translateY(-2px);
  }

  .ai-bc-how-it-works-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.section_bg_color }};
  }

  .ai-bc-how-title-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.section_title_size }}px;
    margin: 0 0 60px;
    color: {{ block.settings.section_text_color }};
  }

  .ai-bc-steps-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-bc-step-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-bc-step-number-{{ ai_gen_id }} {
    width: {{ block.settings.step_number_size }}px;
    height: {{ block.settings.step_number_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.step_number_bg_color }};
    color: {{ block.settings.step_number_text_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: {{ block.settings.step_number_font_size }}px;
    font-weight: bold;
    margin: 0 auto 20px;
  }

  .ai-bc-step-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.step_title_size }}px;
    margin: 0 0 12px;
    color: {{ block.settings.section_text_color }};
  }

  .ai-bc-step-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.step_description_size }}px;
    color: {{ block.settings.section_text_color }};
    line-height: 1.6;
    opacity: 0.9;
  }

  .ai-bc-stylists-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.stylists_bg_color }};
  }

  .ai-bc-stylists-title-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.section_title_size }}px;
    margin: 0 0 40px;
    color: {{ block.settings.stylists_text_color }};
  }

  .ai-bc-stylists-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-bc-stylist-card-{{ ai_gen_id }} {
    text-align: center;
    padding: 30px;
    background-color: {{ block.settings.stylist_card_bg_color }};
    border-radius: {{ block.settings.stylist_card_radius }}px;
  }

  .ai-bc-stylist-image-{{ ai_gen_id }} {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    object-fit: cover;
    margin: 0 auto 20px;
    display: block;
  }

  .ai-bc-stylist-image-placeholder-{{ ai_gen_id }} {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    background-color: #f4f4f4;
    margin: 0 auto 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .ai-bc-stylist-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-bc-stylist-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.stylist_name_size }}px;
    margin: 0 0 8px;
    color: {{ block.settings.stylists_text_color }};
    font-weight: bold;
  }

  .ai-bc-stylist-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.stylist_title_size }}px;
    color: {{ block.settings.stylists_text_color }};
    opacity: 0.8;
    margin: 0 0 12px;
  }

  .ai-bc-stylist-bio-{{ ai_gen_id }} {
    font-size: {{ block.settings.stylist_bio_size }}px;
    color: {{ block.settings.stylists_text_color }};
    line-height: 1.6;
    opacity: 0.9;
  }

  @media screen and (max-width: 768px) {
    .ai-bc-hero-{{ ai_gen_id }} {
      min-height: {{ block.settings.hero_height | times: 0.7 }}px;
      padding: 40px 20px;
    }

    .ai-bc-hero-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.hero_title_size | times: 0.6 }}px;
    }

    .ai-bc-hero-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.hero_subtitle_size | times: 0.8 }}px;
    }

    .ai-bc-steps-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-bc-how-it-works-{{ ai_gen_id }},
    .ai-bc-stylists-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.6 }}px 20px;
    }

    .ai-bc-how-title-{{ ai_gen_id }},
    .ai-bc-stylists-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.section_title_size | times: 0.7 }}px;
      margin-bottom: 40px;
    }
  }
{% endstyle %}

<bc-style-club-{{ ai_gen_id }} class="ai-bc-style-club-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-bc-hero-{{ ai_gen_id }}">
    {% if block.settings.hero_image %}
      <img
        src="{{ block.settings.hero_image | image_url: width: 2000 }}"
        alt="{{ block.settings.hero_image.alt | escape }}"
        class="ai-bc-hero-image-{{ ai_gen_id }}"
        loading="lazy"
        width="{{ block.settings.hero_image.width }}"
        height="{{ block.settings.hero_image.height }}"
      >
    {% endif %}
    <div class="ai-bc-hero-overlay-{{ ai_gen_id }}"></div>
    <div class="ai-bc-hero-content-{{ ai_gen_id }}">
      {% if block.settings.hero_title != blank %}
        <h1 class="ai-bc-hero-title-{{ ai_gen_id }}">{{ block.settings.hero_title }}</h1>
      {% endif %}
      {% if block.settings.hero_subtitle != blank %}
        <div class="ai-bc-hero-subtitle-{{ ai_gen_id }}">{{ block.settings.hero_subtitle }}</div>
      {% endif %}
      {% if block.settings.cta_text != blank %}
        <a href="{{ block.settings.cta_link }}" class="ai-bc-hero-cta-{{ ai_gen_id }}">
          {{ block.settings.cta_text }}
        </a>
      {% endif %}
    </div>
  </div>

  <div class="ai-bc-how-it-works-{{ ai_gen_id }}">
    {% if block.settings.how_it_works_title != blank %}
      <h2 class="ai-bc-how-title-{{ ai_gen_id }}">{{ block.settings.how_it_works_title }}</h2>
    {% endif %}
    <div class="ai-bc-steps-container-{{ ai_gen_id }}">
      <div class="ai-bc-step-{{ ai_gen_id }}">
        <div class="ai-bc-step-number-{{ ai_gen_id }}">1</div>
        <h3 class="ai-bc-step-title-{{ ai_gen_id }}">{{ block.settings.step_1_title }}</h3>
        <div class="ai-bc-step-description-{{ ai_gen_id }}">{{ block.settings.step_1_description }}</div>
      </div>
      <div class="ai-bc-step-{{ ai_gen_id }}">
        <div class="ai-bc-step-number-{{ ai_gen_id }}">2</div>
        <h3 class="ai-bc-step-title-{{ ai_gen_id }}">{{ block.settings.step_2_title }}</h3>
        <div class="ai-bc-step-description-{{ ai_gen_id }}">{{ block.settings.step_2_description }}</div>
      </div>
      <div class="ai-bc-step-{{ ai_gen_id }}">
        <div class="ai-bc-step-number-{{ ai_gen_id }}">3</div>
        <h3 class="ai-bc-step-title-{{ ai_gen_id }}">{{ block.settings.step_3_title }}</h3>
        <div class="ai-bc-step-description-{{ ai_gen_id }}">{{ block.settings.step_3_description }}</div>
      </div>
    </div>
  </div>

  {% if block.settings.show_stylists %}
    <div class="ai-bc-stylists-{{ ai_gen_id }}">
      {% if block.settings.stylists_title != blank %}
        <h2 class="ai-bc-stylists-title-{{ ai_gen_id }}">{{ block.settings.stylists_title }}</h2>
      {% endif %}
      <div class="ai-bc-stylists-grid-{{ ai_gen_id }}">
        {% if block.settings.show_founder %}
          <div class="ai-bc-stylist-card-{{ ai_gen_id }}">
            {% if block.settings.founder_image %}
              <img
                src="{{ block.settings.founder_image | image_url: width: 300 }}"
                alt="{{ block.settings.founder_name | escape }}"
                class="ai-bc-stylist-image-{{ ai_gen_id }}"
                loading="lazy"
                width="150"
                height="150"
              >
            {% else %}
              <div class="ai-bc-stylist-image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
            <h3 class="ai-bc-stylist-name-{{ ai_gen_id }}">{{ block.settings.founder_name }}</h3>
            <div class="ai-bc-stylist-title-{{ ai_gen_id }}">{{ block.settings.founder_title }}</div>
            {% if block.settings.founder_bio != blank %}
              <div class="ai-bc-stylist-bio-{{ ai_gen_id }}">{{ block.settings.founder_bio }}</div>
            {% endif %}
          </div>
        {% endif %}

        {% for i in (1..3) %}
          {% liquid
            assign show_key = 'show_stylist_' | append: i
            assign name_key = 'stylist_' | append: i | append: '_name'
            assign title_key = 'stylist_' | append: i | append: '_title'
            assign bio_key = 'stylist_' | append: i | append: '_bio'
            assign image_key = 'stylist_' | append: i | append: '_image'

            assign show_stylist = block.settings[show_key]
            assign stylist_name = block.settings[name_key]
            assign stylist_title = block.settings[title_key]
            assign stylist_bio = block.settings[bio_key]
            assign stylist_image = block.settings[image_key]
          %}

          {% if show_stylist %}
            <div class="ai-bc-stylist-card-{{ ai_gen_id }}">
              {% if stylist_image %}
                <img
                  src="{{ stylist_image | image_url: width: 300 }}"
                  alt="{{ stylist_name | escape }}"
                  class="ai-bc-stylist-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="150"
                  height="150"
                >
              {% else %}
                <div class="ai-bc-stylist-image-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
              <h3 class="ai-bc-stylist-name-{{ ai_gen_id }}">{{ stylist_name }}</h3>
              <div class="ai-bc-stylist-title-{{ ai_gen_id }}">{{ stylist_title }}</div>
              {% if stylist_bio != blank %}
                <div class="ai-bc-stylist-bio-{{ ai_gen_id }}">{{ stylist_bio }}</div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endif %}
</bc-style-club-{{ ai_gen_id }}>

<script>
  (function() {
    class BcStyleClub{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupSmoothScroll();
      }

      setupSmoothScroll() {
        const ctaButton = this.querySelector('.ai-bc-hero-cta-{{ ai_gen_id }}');
        if (ctaButton && ctaButton.getAttribute('href').startsWith('#')) {
          ctaButton.addEventListener('click', (e) => {
            e.preventDefault();
            const targetId = ctaButton.getAttribute('href').substring(1);
            const targetElement = document.getElementById(targetId);
            if (targetElement) {
              targetElement.scrollIntoView({ behavior: 'smooth' });
            }
          });
        }
      }
    }

    customElements.define('bc-style-club-{{ ai_gen_id }}', BcStyleClub{{ ai_gen_id }});
  })();
</script>

