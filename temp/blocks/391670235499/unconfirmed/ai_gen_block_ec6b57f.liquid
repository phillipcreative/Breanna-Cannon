{% doc %}
  @prompt
    make a how it works section with 1,2,3. "Pick a time, Pick a stylist, Book an appointment." 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-how-it-works-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-how-it-works-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-how-it-works-heading-{{ ai_gen_id }} {
    text-align: center;
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-how-it-works-steps-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.step_gap }}px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ai-how-it-works-step-{{ ai_gen_id }} {
    text-align: center;
    padding: {{ block.settings.step_padding }}px;
    background-color: {{ block.settings.step_background_color }};
    border-radius: {{ block.settings.step_border_radius }}px;
  }

  .ai-how-it-works-number-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: {{ block.settings.number_size }}px;
    height: {{ block.settings.number_size }}px;
    background-color: {{ block.settings.number_background_color }};
    color: {{ block.settings.number_text_color }};
    border-radius: 50%;
    font-size: {{ block.settings.number_font_size }}px;
    font-weight: 700;
    margin: 0 auto {{ block.settings.number_spacing }}px;
  }

  .ai-how-it-works-step-title-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.step_title_color }};
    font-size: {{ block.settings.step_title_size }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-how-it-works-steps-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.step_gap | times: 0.75 }}px;
    }

    .ai-how-it-works-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-how-it-works-step-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.step_title_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<how-it-works-{{ ai_gen_id }} class="ai-how-it-works-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-how-it-works-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-how-it-works-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <ol class="ai-how-it-works-steps-{{ ai_gen_id }}">
      <li class="ai-how-it-works-step-{{ ai_gen_id }}">
        <div class="ai-how-it-works-number-{{ ai_gen_id }}">1</div>
        <h3 class="ai-how-it-works-step-title-{{ ai_gen_id }}">{{ block.settings.step_1_title }}</h3>
      </li>

      <li class="ai-how-it-works-step-{{ ai_gen_id }}">
        <div class="ai-how-it-works-number-{{ ai_gen_id }}">2</div>
        <h3 class="ai-how-it-works-step-title-{{ ai_gen_id }}">{{ block.settings.step_2_title }}</h3>
      </li>

      <li class="ai-how-it-works-step-{{ ai_gen_id }}">
        <div class="ai-how-it-works-number-{{ ai_gen_id }}">3</div>
        <h3 class="ai-how-it-works-step-title-{{ ai_gen_id }}">{{ block.settings.step_3_title }}</h3>
      </li>
    </ol>
  </div>
</how-it-works-{{ ai_gen_id }}>

<script>
  (function() {
    class HowItWorks{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('how-it-works-{{ ai_gen_id }}', HowItWorks{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "How it works",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "How it works"
    },
    {
      "type": "inline_richtext",
      "id": "step_1_title",
      "label": "Step 1 title",
      "default": "Pick a time"
    },
    {
      "type": "inline_richtext",
      "id": "step_2_title",
      "label": "Step 2 title",
      "default": "Pick a stylist"
    },
    {
      "type": "inline_richtext",
      "id": "step_3_title",
      "label": "Step 3 title",
      "default": "Book an appointment"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "step_gap",
      "label": "Gap between steps",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "step_padding",
      "label": "Step padding",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "step_border_radius",
      "label": "Step border radius",
      "min": 0,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "step_background_color",
      "label": "Step background",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "step_title_color",
      "label": "Step title",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "number_background_color",
      "label": "Number background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "number_text_color",
      "label": "Number text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Heading spacing",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "step_title_size",
      "label": "Step title size",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "number_size",
      "label": "Number circle size",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "number_font_size",
      "label": "Number font size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "number_spacing",
      "label": "Number spacing",
      "min": 10,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "How it works"
    }
  ]
}
{% endschema %}
